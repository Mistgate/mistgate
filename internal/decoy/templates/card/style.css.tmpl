{{template "base_css" .}}
.__avatar__{display:grid;place-items:center;width:{{if eq .Layout 0}}104{{else}}84{{end}}px;height:{{if eq .Layout 0}}104{{else}}84{{end}}px;margin-bottom:18px;border-radius:{{if eq .S.R 0}}0{{else}}50%{{end}};background:var(--ac);color:var(--ai);font:700 {{if eq .Layout 0}}2.6{{else}}2{{end}}rem var(--fh)}
.__hello__{margin:0;color:var(--mu)}
.__me__ h1{margin:.1em 0 .1em}
.__role__{margin:0 0 .6em;color:var(--ac);font-weight:600}
.__bio__{max-width:520px;margin:0 0 24px;color:var(--mu)}
.__links__{display:flex;flex-direction:column;gap:12px;margin:0;padding:0;list-style:none}
.__links__ a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 18px;border:1px solid var(--ln);border-radius:var(--rs);background:var(--sf);color:var(--fg);text-decoration:none;box-shadow:var(--sh);transition:border-color .15s,transform .15s}
.__links__ a:hover{border-color:var(--ac);transform:translateY(-1px)}
.__lt__{display:flex;flex-direction:column}
.__lt__ span{color:var(--mu);font-size:.9rem}
.__links__ .__ic__{color:var(--ac)}
.__text__{max-width:720px;padding-top:48px}
.__text__ > p{font-size:1.06rem}
.__facts__{margin:0;padding:0;list-style:none}
.__facts__ li{display:flex;gap:10px;align-items:flex-start;padding:.5em 0;border-bottom:1px solid var(--ln)}
.__facts__ .__ic__{margin-top:.2em;color:var(--ac)}
.__proj__{display:grid;gap:16px;margin:24px 0 0;padding:0;list-style:none}
.__proj__ h2{margin:.2em 0 .2em;font-size:1.25rem}
.__proj__ p{margin:0;color:var(--mu)}
.__year__{color:var(--ac);font-size:.85rem;font-weight:700}
.__tiny__{margin-top:28px;color:var(--mu);font-size:.8rem;text-align:center}
{{if eq .Layout 0}}body{background:linear-gradient(180deg,var(--so),var(--bg) 60%)}
.__single__{width:100%;max-width:460px;margin:0 auto;padding:56px 20px 32px;text-align:center}
.__single__ .__bio__{margin-right:auto;margin-left:auto}
.__single__ .__avatar__{margin-right:auto;margin-left:auto}
.__single__ .__links__ a{text-align:left}
{{else if eq .Layout 1}}.__left__{max-width:720px;padding-top:56px}
{{else}}.__duo__{display:grid;gap:32px;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:start;padding-top:56px}
.__sticky__{position:sticky;top:24px;padding:28px}
@media (max-width:820px){.__duo__{display:block;padding-top:32px}.__sticky__{position:static;margin-bottom:20px}}
{{end}}@media (max-width:560px){.__text__{padding-top:28px}.__left__{padding-top:32px}}
.__mini__{margin-top:22px;color:var(--mu);font-size:.92rem;text-align:left}
