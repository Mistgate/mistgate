{{template "base_css" .}}
.__kicker__{margin:0 0 6px;color:var(--ac);font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.__box__{width:100%;max-width:{{if eq .Layout 2}}460{{else}}420{{end}}px}
.__form__{margin-top:22px}
.__row__{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 12px;margin:2px 0 16px;font-size:.92rem}
.__chk__{display:flex;align-items:center;gap:8px}
.__wide__{width:100%;justify-content:center}
.__wide__:disabled{opacity:.7;cursor:progress}
.__err__{margin:0 0 14px;padding:.6em .8em;border:1px solid var(--bd);border-radius:var(--rs);color:var(--bd);font-size:.92rem}
.__err__[hidden]{display:none}
.__points__{display:flex;flex-direction:column;gap:8px;margin:0;padding:0;list-style:none;color:var(--mu);font-size:.95rem}
.__points__ li{display:flex;gap:8px;align-items:flex-start}
.__points__ .__ic__{margin-top:.15em;color:var(--ok)}
.__prose__{max-width:720px;padding-top:48px}
.__prose__ li{margin-bottom:.4em}
.__prose__ h2{margin-top:1.6em}
{{if eq .Layout 0}}.__auth__{display:flex;flex-direction:column;align-items:center;gap:24px;padding-top:56px}
.__box__{padding:28px}
{{else if eq .Layout 2}}.__auth__{display:grid;grid-template-columns:minmax(0,460px) minmax(0,1fr);gap:48px 72px;align-items:start;padding-top:64px}
.__flat__ h1{font-size:clamp(1.9rem,5vw,2.4rem)}
.__points__{padding-top:56px;font-size:1.02rem}
@media (max-width:820px){.__auth__{display:flex;flex-direction:column;gap:20px;padding-top:36px}.__points__{padding-top:0}}
{{else}}.__split__{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);min-height:100vh}
.__side__{position:relative;overflow:hidden;color:#fff}
.__side__ .__art__{position:absolute;inset:0;height:100%}
.__side__::after{content:"";position:absolute;inset:0;background:linear-gradient(160deg,rgba(0,0,0,.05),rgba(0,0,0,.55))}
.__sidein__{position:relative;z-index:1;display:flex;flex-direction:column;justify-content:space-between;gap:48px;height:100%;padding:36px}
.__side__ .__logo__{color:#fff}
.__side__ .__points__{color:#fff}
.__side__ .__points__ .__ic__{color:#fff}
.__main__{display:flex;align-items:center;justify-content:center;padding:40px 24px}
.__main__ .__ftnav__{margin-top:28px;font-size:.9rem}
@media (max-width:820px){.__split__{grid-template-columns:1fr}.__side__{min-height:200px}.__sidein__{gap:20px;padding:22px}.__side__ .__points__{display:none}.__main__{padding:32px 20px}}
{{end}}
