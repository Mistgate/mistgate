{
  "title": {"en": "Personal blog", "ru": "Личный блог (заметки)"},
  "layouts": 3,
  "pages": [
    {"name": "home", "tmpl": "home.html.tmpl", "paths": ["index.html"], "nav": "nav_home", "title": "home_title", "desc": "desc"},
    {"name": "about", "tmpl": "about.html.tmpl", "paths": ["about.html", "about/index.html", "me/index.html", "hello.html"], "nav": "nav_about", "desc": "desc_about"},
    {"name": "post", "tmpl": "post.html.tmpl", "paths": ["notes/{slug}.html", "posts/{slug}/index.html", "{slug}.html", "journal/{slug}/index.html"], "each": "posts"}
  ],
  "lists": [
    {"name": "posts", "from": "posts", "min": 4, "max": 5, "dates": {"end": "2026-10-28", "gap_min": 8, "gap_max": 40}}
  ]
}
