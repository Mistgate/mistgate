{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __blogmain__">
<section class="__intro__">
<h1>{{.Brand}}</h1>
<p class="__lede__">{{.L.intro}}</p>
</section>
<div class="__cols__">
<div class="__feed__">
<h2 class="__sectitle__">{{.L.latest_h}}</h2>
{{range .Lists.posts}}<article class="__entry__">
{{if eq $.Layout 2}}<a class="__thumb__" href="{{.href}}" tabindex="-1" aria-hidden="true">{{art (printf "t%d" .n) "" 480 300}}</a>{{end}}
<div class="__ebody__">
<p class="__meta__"><time datetime="{{.date_iso}}">{{.date}}</time> · <span class="__pill__">{{.tag}}</span></p>
<h2><a href="{{.href}}">{{.title}}</a></h2>
<p>{{.excerpt}}</p>
<a class="__readmore__" href="{{.href}}">{{$.L.read_more}} {{icon "arrow"}}</a>
</div>
</article>
{{end}}</div>
{{if eq .Layout 1}}<aside class="__side__">
<h2 class="__sectitle__">{{.L.about_h}}</h2>
<p>{{index .L.about 0}}</p>
<p><a href="{{(index .Nav 1).Href}}">{{(index .Nav 1).Label}} {{icon "arrow"}}</a></p>
<h2 class="__sectitle__">{{.L.now_h}}</h2>
<ul>{{range .L.now}}<li>{{.}}</li>{{end}}</ul>
</aside>{{end}}
</div>
</main>
{{template "footer" .}}
</body>
</html>
