{{template "base_css" .}}
.__sec__{margin-top:52px}
.__page__{padding-top:48px}
.__lede__{max-width:620px;color:var(--mu);font-size:1.15rem}
.__hero__ h1{margin-bottom:.25em;font-size:clamp(2.2rem,6vw,3.4rem)}
.__hero__ .__btn__{margin-right:8px;margin-bottom:8px}
.__term__{overflow:hidden;border:1px solid var(--ln);border-radius:var(--r);background:var(--sf);box-shadow:var(--sh)}
.__term__ pre{margin:0;padding:16px 18px;overflow-x:auto;line-height:1.6}
.__term__ code::before{content:"$ ";color:var(--ac)}
.__dots__{display:flex;gap:6px;padding:10px 14px;border-bottom:1px solid var(--ln)}
.__dots__ i{display:block;width:10px;height:10px;border-radius:50%;background:var(--ln)}
.__feats__{display:grid;gap:16px;margin:16px 0 0;padding:0;list-style:none;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}
.__feats__ h3{margin-bottom:.25em}
.__feats__ p{margin:0;color:var(--mu);font-size:.95rem}
.__rel__{padding:20px 0;border-bottom:1px solid var(--ln)}
.__rel__ h2,.__rel__ h3{margin-bottom:.5em;font-size:1.3rem}
.__rel__ h2 .__mu__,.__rel__ h3 .__mu__{margin-left:.5em;font:400 .9rem var(--fb)}
.__notes__{margin:0;padding:0;list-style:none}
.__notes__ li{display:flex;gap:10px;align-items:baseline;margin-bottom:.4em}
.__k__{flex:none;min-width:4.6em;color:var(--ac);font-size:.78rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
.__road__{display:grid;gap:16px;margin-top:28px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
.__road__ h2{margin-bottom:.4em;font-size:1.2rem}
.__road__ ul{margin:0}
pre code,.__tbl__ code{font-size:.9rem}
{{if eq .Layout 0}}.__split__{display:grid;gap:40px;align-items:center;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);padding-top:64px;padding-bottom:8px}
{{else if eq .Layout 1}}.__band__{background:var(--so)}
.__centre__{padding-top:72px;padding-bottom:64px;text-align:center}
.__centre__ .__lede__{margin-right:auto;margin-left:auto}
{{else}}.__dark__{padding:64px 0 56px;background:#10151c;color:#e8edf3}
.__dark__ .__lede__{color:#a9b6c6}
.__dark__ .__term__{max-width:560px;margin:24px 0;border-color:#2a3441;background:#161d27;box-shadow:none}
.__dark__ .__dots__{border-color:#2a3441}
.__dark__ .__dots__ i{background:#2a3441}
.__dark__ pre{color:#e8edf3}
.__dark__ .__ghost__{color:#e8edf3;border-color:#3a4658}
{{end}}@media (max-width:820px){.__split__{display:flex;flex-direction:column;gap:28px;padding-top:36px}.__centre__{padding-top:44px;padding-bottom:40px}.__page__{padding-top:32px}.__dark__{padding-top:40px}}
.__sec__ .__term__{margin:16px 0}
