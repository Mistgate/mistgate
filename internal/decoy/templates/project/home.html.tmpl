{{define "term"}}<div class="__term__"><span class="__dots__"><i></i><i></i><i></i></span><pre><code>{{.L.quick}}</code></pre></div>
{{end}}
{{define "b_features"}}<section class="__sec__">
<h2>{{.L.features_h}}</h2>
<ul class="__feats__">{{range .L.features}}<li class="__card__"><h3>{{.h}}</h3><p>{{.p}}</p></li>{{end}}</ul>
</section>{{end}}
{{define "b_start"}}<section class="__sec__">
<h2>{{.L.start_h}}</h2>
<p>{{.L.overview}}</p>
{{if eq .Layout 1}}{{template "term" .}}
{{end}}<p><a class="__btn__" href="{{(index .Nav 2).Href}}">{{icon "download"}} {{.L.get_it}} {{(index .Lists.releases 0).version}}</a></p>
</section>{{end}}
{{define "b_latest"}}<section class="__sec__">
<h2>{{.L.latest_h}}</h2>
{{with index .Lists.releases 0}}<article class="__rel__">
<h3>{{$.Brand}} {{.version}} <span class="__mu__">{{.date}}</span></h3>
<ul class="__notes__">{{range .notes}}<li><span class="__k__">{{.k}}</span> {{.t}}</li>{{end}}</ul>
</article>{{end}}
<p><a href="{{(index .Nav 1).Href}}">{{.L.all_releases}} {{icon "arrow"}}</a></p>
</section>{{end}}
{{template "head" .}}<body>
{{template "header" .}}
<main>
{{if eq .Layout 0}}<section class="__wrap__ __hero__ __split__">
<div>
<h1>{{.Brand}}</h1>
<p class="__lede__">{{.L.tagline}}</p>
<p><a class="__btn__" href="{{(index .Nav 2).Href}}">{{icon "download"}} {{.L.get_it}}</a> <a class="__btn__ __ghost__" href="{{(index .Nav 1).Href}}">{{.L.read_log}}</a></p>
</div>
{{template "term" .}}
</section>
{{else if eq .Layout 1}}<section class="__band__">
<div class="__wrap__ __hero__ __centre__">
<h1>{{.Brand}}</h1>
<p class="__lede__">{{.L.tagline}}</p>
<p><a class="__btn__" href="{{(index .Nav 2).Href}}">{{icon "download"}} {{.L.get_it}}</a> <a class="__btn__ __ghost__" href="{{(index .Nav 1).Href}}">{{.L.read_log}}</a></p>
</div>
</section>
{{else}}<section class="__dark__">
<div class="__wrap__ __hero__">
<h1>{{.Brand}}</h1>
<p class="__lede__">{{.L.tagline}}</p>
{{template "term" .}}
<p><a class="__btn__" href="{{(index .Nav 2).Href}}">{{icon "download"}} {{.L.get_it}}</a> <a class="__btn__ __ghost__" href="{{(index .Nav 1).Href}}">{{.L.read_log}}</a></p>
</div>
</section>
{{end}}<div class="__wrap__">
{{range .Order}}{{blk . $}}{{end}}
</div>
</main>
{{template "footer" .}}
</body>
</html>
