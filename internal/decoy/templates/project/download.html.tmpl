{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __page__">
<h1>{{.L.download_h}} {{.Brand}} {{(index .Lists.releases 0).version}}</h1>
<p class="__lede__">{{.L.download_intro}}</p>
<div class="__tbl__"><table>
<thead><tr><th>{{.L.col_sys}}</th><th>{{.L.col_file}}</th><th>{{.L.col_size}}</th></tr></thead>
<tbody>{{$v := (index .Lists.releases 0).version}}{{$cmd := .V.cmd}}{{range $i, $s := .L.sys}}<tr><td>{{$s}}</td><td><code>{{$cmd}}-{{$v}}-{{if eq $i 0}}linux-amd64.tar.gz{{else if eq $i 1}}linux-arm64.tar.gz{{else if eq $i 2}}macos-arm64.tar.gz{{else if eq $i 3}}macos-amd64.tar.gz{{else}}windows-amd64.zip{{end}}</code></td><td>{{num (printf "sa%d" $i) 2 8}}.{{num (printf "sb%d" $i) 0 9}} MB</td></tr>{{end}}</tbody>
</table></div>
<p>{{.L.download_note}}</p>
<h2>{{.L.licence_h}}</h2>
<p>{{.L.licence_p}}</p>
</main>
{{template "footer" .}}
</body>
</html>
