{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __page__">
<h1>{{.L.contact_h}}</h1>
<p class="__lede__">{{.L.contact_intro}}</p>
<section class="__visit__">
<div class="__card__">
<h2>{{.L.address_l}}</h2>
<p>{{icon "pin"}} {{.V.n}} {{.V.street}}, {{.V.city}}</p>
<h2>{{.L.phone_l}}</h2>
<p>{{icon "phone"}} 555-0{{.V.ph}}</p>
</div>
<div class="__card__">
<h2>{{.L.hours_h}}</h2>
<ul class="__hours__">{{range .L.hours}}<li>{{.}}</li>{{end}}</ul>
</div>
</section>
<p class="__mu__">{{.L.contact_note}}</p>
</main>
{{template "footer" .}}
</body>
</html>
