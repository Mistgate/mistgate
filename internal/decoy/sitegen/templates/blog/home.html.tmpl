{{define "feat_text"}}{{$f := index .Lists.posts 0}}<div class="__ft__"><span class="__lab__ __tag__">{{$f.tag}}</span>
<h1 class="__t__">{{$f.title}}</h1>
<p class="__ex__">{{$f.excerpt}}</p>
<p class="__dc__">{{index $f.body 0}}</p>
<a class="__more__" href="{{$f.href}}">{{.L.read_more}} →</a>
<div class="__meta__">{{num (printf "mr%s" $f.slug) 3 7}} {{.L.min_read}}</div></div>{{end}}
{{define "feat_pic"}}{{$f := index .Lists.posts 0}}<a class="__fpic__" href="{{$f.href}}" tabindex="-1" aria-hidden="true">{{photo (printf "t%d" $f.n) "" 960 720}}</a>{{end}}
{{define "b_stmt"}}<div class="__wrap__ __stw__"><section class="__stmt__"><p>{{.L.intro}}</p></section></div>{{end}}
{{define "b_cols"}}<div class="__wrap__ __cols__">
<section class="__latest__">
<h2 class="__sh__">{{.L.latest_h}}</h2>
{{range $i, $p := .Lists.posts}}{{if ge $i 1}}{{if lt $i 6}}<article class="__li__"><span class="__n__">0{{$i}}</span><div><span class="__lab__ __tag__">{{$p.tag}}</span><h3><a href="{{$p.href}}">{{$p.title}}</a></h3><p>{{$p.excerpt}}</p><div class="__meta__">{{num (printf "mr%s" $p.slug) 3 7}} {{$.L.min_read}}</div></div><a class="__lph__" href="{{$p.href}}" tabindex="-1" aria-hidden="true">{{photo (printf "t%d" $p.n) "" 360 360}}</a></article>
{{end}}{{end}}{{end}}<a class="__more__" href="{{(index .Nav 2).Href}}">{{.L.all_posts}} →</a>
</section>
{{template "side" .}}
</div>{{end}}
{{define "side"}}<aside class="__side__">
<div><h2 class="__lab__ __sh5__">{{.L.about_h}}</h2>{{range $i, $a := .L.about}}{{if lt $i 2}}<p>{{$a}}</p>{{end}}{{end}}</div>
<div><h2 class="__lab__ __sh5__">{{.L.now_h}}</h2><ul>{{range .L.now}}<li>{{.}}</li>{{end}}</ul></div>
<div class="__nob__"><h2 class="__lab__ __sh5__">{{.L.tags_h}}</h2><div class="__tags__">{{range tags .Lists.posts "tag"}}<a class="__tg__" href="{{(index $.Nav 2).Href}}">{{.tag}}<sup class="__tn__">{{.n}}</sup></a>{{end}}</div></div>
</aside>{{end}}
{{define "b_quote"}}{{$f := index .Lists.posts 0}}{{$q := ""}}{{range $f.body}}{{if eq $q ""}}{{$q = .}}{{else if lt (len .) (len $q)}}{{$q = .}}{{end}}{{end}}<section class="__q__"><div class="__wrap__ __qin__"><i aria-hidden="true">“</i><div><blockquote>{{$q}}</blockquote><cite class="__lab__">{{$f.title}}</cite></div></div></section>{{end}}
{{define "b_arch"}}<section class="__wrap__ __arch__">
<h2 class="__sh__">{{.L.nav_archive}}</h2>
{{$m := ""}}{{$k := 0}}{{range .Lists.posts}}{{$new := 0}}{{if ne .month $m}}{{$m = .month}}{{$k = add $k 1}}{{$new = 1}}{{end}}{{if le $k 3}}<div class="__ar__{{if eq $new 1}} __nm__{{end}}"><h3>{{if eq $new 1}}{{.month_label}}{{end}}</h3><div class="__arli__"><a href="{{.href}}">{{.title}}</a><span class="__arg__">{{.tag}}</span></div></div>
{{end}}{{end}}</section>{{end}}
{{template "head" .}}<body>
{{template "header" .}}
<main>
<div class="__wrap__">
{{if eq .Layout 0}}<article class="__feat__">
{{template "feat_pic" .}}
{{template "feat_text" .}}
</article>
{{else if eq .Layout 1}}<article class="__feat__ __feat1__">
{{template "feat_text" .}}
{{template "feat_pic" .}}
</article>
{{else}}<article class="__feat__ __feat2__">
{{template "feat_text" .}}
{{template "feat_pic" .}}
</article>
{{end}}</div>
{{range .Order}}{{blk . $}}{{end}}
</main>
{{template "footer" .}}
</body>
</html>
