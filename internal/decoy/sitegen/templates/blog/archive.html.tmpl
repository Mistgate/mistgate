{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __arc__">
<section>
<span class="__lab__ __tag__">{{.L.nav_archive}}</span>
<h1 class="__t__">{{.L.archive_h}}</h1>
<p class="__ex__">{{.L.archive_intro}}</p>
{{$m := ""}}{{range .Lists.posts}}{{$new := 0}}{{if ne .month $m}}{{$m = .month}}{{$new = 1}}{{end}}<div class="__ar__ __arp__{{if eq $new 1}} __nm__{{end}}"><h3>{{if eq $new 1}}{{.month_label}}{{end}}</h3><div class="__arli__"><a href="{{.href}}">{{.title}}</a><span class="__ardate__">{{.date}}</span><span class="__arg__">{{.tag}}</span></div></div>
{{end}}</section>
{{template "side" .}}
</main>
{{template "footer" .}}
</body>
</html>
