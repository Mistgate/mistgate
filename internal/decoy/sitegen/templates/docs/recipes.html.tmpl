{{template "head" .}}<body>
{{template "header" .}}
<div class="__shell__">
{{template "sidenav" .}}
<main class="__main__">
<div class="__crumb__">{{.L.menu_h}} / {{.L.ref_h}} / {{(index .Nav 4).Label}}</div>
<h1>{{.L.recipes_h}}</h1>
<p class="__lead__">{{.L.recipes_intro}}</p>
{{range $i, $r := .L.recipes}}<h2 id="__t{{add $i 1}}__">{{$r.h}}</h2>
<p>{{$r.p}}</p>
<div class="__cap__"><span>{{$.L.cap_sh}}</span></div>
<pre class="__pre__"><code>{{hl $r.code "sh"}}</code></pre>
{{end}}<div class="__pn__"><a href="{{(index .Nav 3).Href}}"><small>{{.L.prev}}</small><b>{{(index .Nav 3).Label}}</b></a><a href="{{(index .Nav 5).Href}}"><small>{{.L.next}}</small><b>{{(index .Nav 5).Label}}</b></a></div>
</main>
<aside class="__tc__" aria-label="{{.L.toc_h}}">
<h6>{{.L.toc_h}}</h6>
{{range $i, $r := .L.recipes}}<a href="#__t{{add $i 1}}__">{{$r.h}}</a>{{end}}
{{template "glance" .}}
</aside>
</div>
{{template "footer" .}}
</body>
</html>
