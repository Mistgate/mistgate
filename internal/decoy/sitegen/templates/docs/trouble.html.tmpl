{{template "head" .}}<body>
{{template "header" .}}
<div class="__shell__">
{{template "sidenav" .}}
<main class="__main__">
<div class="__crumb__">{{.L.menu_h}} / {{.L.ref_h}} / {{(index .Nav 5).Label}}</div>
<h1>{{.L.trouble_h}}</h1>
<p class="__lead__">{{.L.trouble_intro}}</p>
<div class="__faq__">{{range $i, $q := .L.trouble}}<details id="__t{{add $i 1}}__"{{if eq $i 0}} open{{end}}><summary>{{$q.q}}</summary><p>{{$q.a}}</p></details>{{end}}</div>
<div class="__pn__"><a href="{{(index .Nav 4).Href}}"><small>{{.L.prev}}</small><b>{{(index .Nav 4).Label}}</b></a><a href="{{(index .Nav 6).Href}}"><small>{{.L.next}}</small><b>{{(index .Nav 6).Label}}</b></a></div>
</main>
<aside class="__tc__" aria-label="{{.L.toc_h}}">
<h6>{{.L.toc_h}}</h6>
{{range $i, $q := .L.trouble}}<a href="#__t{{add $i 1}}__">{{$q.q}}</a>{{end}}
</aside>
</div>
{{template "footer" .}}
</body>
</html>
