{{template "base_vars" .}}{{template "base_core" .}}{{template "base_pages" .}}{{template "draw_css" .}}
pre,code{font-family:var(--fm)}
a{color:inherit;text-decoration:none}
.__mono__{font-family:var(--fm)}
.__bar__{position:sticky;top:0;z-index:3;background:var(--bg);border-bottom:var(--bw) solid var(--ln)}
.__bin__{position:relative;max-width:var(--w);margin:0 auto;height:64px;display:flex;align-items:center;gap:24px;padding:0 clamp(16px,2.4vw,32px)}
.__logo__{display:flex;align-items:center;gap:10px;font:750 1.2rem var(--fh);letter-spacing:var(--lsh);width:236px;min-width:0}
.__lm__{flex:none;display:grid;place-items:center;width:28px;height:28px;border-radius:var(--rs);background:var(--ac);color:var(--ai);font:750 .95rem var(--fh);font-style:normal;letter-spacing:0}
.__logo__ span{min-width:0;overflow-wrap:anywhere}
.__ver__{font:.82rem var(--fm);border:1px solid var(--ln2);border-radius:99px;padding:3px 12px;color:var(--mu);background:var(--sf);white-space:nowrap}
.__tn__{margin-left:auto;display:flex;gap:6px;font-size:.94rem}
.__tn__ a{padding:7px 12px;border-radius:var(--rs);color:var(--mu)}
.__tn__ a:hover{color:var(--fg)}
.__tn__ a[aria-current]{color:var(--fg);background:var(--sf2)}
.__mn__{margin-left:auto}
.__mnl__{background:var(--bg)}
.__shell__{max-width:var(--w);margin:0 auto;display:grid;grid-template-columns:236px minmax(0,1fr) 220px;grid-template-areas:"side main toc";gap:clamp(20px,3.4vw,56px);padding:0 clamp(16px,2.4vw,32px)}
.__side__{grid-area:side;position:sticky;top:64px;align-self:start;padding:32px 0;font-size:.94rem}
.__side__ h6,.__tc__ h6{margin:0 0 10px;font:650 .74rem var(--fb);letter-spacing:.1em;text-transform:uppercase;color:var(--mu)}
.__side__ a{display:block;padding:7px 12px;border-radius:var(--rs);color:var(--fg);margin-bottom:2px;overflow-wrap:anywhere}
.__side__ a:hover{background:var(--sf2)}
.__side__ a[aria-current]{background:var(--so);color:var(--ac);color:color-mix(in srgb,var(--ac) 72%,var(--fg));font-weight:650}
.__g__{margin-bottom:28px}
.__main__{grid-area:main;padding:48px 0 32px;min-width:0}
.__crumb__{font:.84rem var(--fm);color:var(--mu);margin-bottom:20px;overflow-wrap:anywhere}
.__main__ h1{font-size:var(--t5);line-height:1.02;margin:0 0 12px;overflow-wrap:anywhere}
.__tag__{font-size:var(--t2);color:var(--ac);color:color-mix(in srgb,var(--ac) 72%,var(--fg));margin:0 0 24px;font-weight:500}
.__lead__{font:400 1.22rem/1.65 var(--fh);color:var(--fg);margin:0 0 36px;max-width:36em;letter-spacing:0}
.__main__ h2{font-size:var(--t3);margin:64px 0 16px;scroll-margin-top:80px;display:flex;align-items:baseline;gap:12px}
.__main__ h2::before{content:"#";color:var(--ln2);font-weight:500}
.__main__ h3{font-size:1.25rem;margin:32px 0 6px}
.__main__ p{margin:0 0 16px;font-size:1.06rem;line-height:1.7;max-width:46em}
.__co__{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.__co__>*{min-width:0}
.__cap__{display:flex;justify-content:space-between;align-items:center;gap:12px;background:var(--cb2);color:var(--cm);border-radius:var(--r) var(--r) 0 0;padding:8px 20px;font:.8rem var(--fm);margin-top:20px}
.__co__ .__cap__{margin-top:0}
pre.__pre__{margin:0 0 20px;padding:20px 24px;border:0;border-radius:var(--r);background:var(--cb);color:var(--ct);font-size:.9rem;line-height:1.7;overflow:auto}
.__co__ pre.__pre__{margin:0}
.__cap__+pre.__pre__{margin-top:0;border-radius:0 0 var(--r) var(--r)}
.__shell__,.__nfw__{--cb:var(--fg);--ct:var(--bg);--cb2:color-mix(in srgb,var(--fg) 88%,var(--bg));--cm:color-mix(in srgb,var(--bg) 60%,var(--fg));--cc:color-mix(in srgb,var(--bg) 48%,var(--fg));--cf:color-mix(in srgb,var(--ac) 62%,var(--bg));--cs:color-mix(in srgb,var(--ok) 62%,var(--bg));--cn:color-mix(in srgb,var(--a2) 55%,var(--bg))}
{{if eq .Scheme "both"}}@media (prefers-color-scheme:dark){.__shell__,.__nfw__{--cb:var(--sf2);--ct:var(--fg);--cb2:var(--sf);--cm:var(--mu);--cc:var(--mu);--cf:var(--ac);--cs:var(--ok);--cn:var(--a2)}}
{{end}}.__pre__ .__dhc__,.__pre__ .__dhp__{color:var(--cc)}
.__pre__ .__dhf__{color:var(--cf)}
.__pre__ .__dhm__{color:var(--cn);font-weight:400}
.__pre__ .__dhs__{color:var(--cs)}
.__pre__ .__dhn__,.__pre__ .__dhk__{color:var(--cn)}
.__feat__{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.__feat__ li{background:var(--sf);border:var(--bw) solid var(--ln);border-radius:var(--r);padding:20px;line-height:1.5;box-shadow:var(--sh)}
.__feat__ .__ic__{display:block;width:26px;height:26px;color:var(--ac);margin-bottom:14px}
.__steps__{list-style:none;padding:0;margin:0 0 24px;counter-reset:s}
.__steps__ li{counter-increment:s;display:flex;gap:16px;padding:10px 0;font-size:1.06rem;align-items:baseline}
.__steps__ li::before{content:counter(s);flex:none;width:30px;height:30px;border-radius:50%;background:var(--so);color:var(--ac);color:color-mix(in srgb,var(--ac) 72%,var(--fg));font:650 .9rem var(--fb);display:grid;place-items:center;transform:translateY(4px)}
.__note__{background:var(--oks);border-radius:var(--r);padding:14px 18px;color:var(--fg);display:flex;gap:12px;align-items:center;margin-bottom:20px}
.__note__ .__ic__{flex:none;color:var(--ok);width:22px;height:22px}
.__tbl__{overflow-x:auto;margin-bottom:24px}
.__tbl__ table{width:100%;border-collapse:collapse}
.__tbl__ th{text-align:left;font:650 .74rem var(--fb);letter-spacing:.1em;text-transform:uppercase;color:var(--mu);padding:10px 14px;border-bottom:2px solid var(--ln2)}
.__tbl__ td{padding:14px;border-bottom:1px solid var(--ln);vertical-align:top}
.__tbl__ td:first-child{white-space:nowrap}
.__tbl__ td code{background:var(--so);border-radius:6px;padding:2px 8px;font-size:.88rem;color:var(--ac);color:color-mix(in srgb,var(--ac) 72%,var(--fg))}
.__faq__ details{border-bottom:1px solid var(--ln);padding:4px 0}
.__faq__ summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:16px;padding:16px 0;font:650 1.14rem var(--fb);letter-spacing:-.01em;scroll-margin-top:80px}
.__faq__ summary::-webkit-details-marker{display:none}
.__faq__ summary::after{content:"+";color:var(--ac);font-weight:400;font-size:1.5rem;line-height:1}
.__faq__ details[open] summary::after{content:"–"}
.__faq__ p{margin:0 0 14px}
.__meta__{display:flex;flex-wrap:wrap;gap:8px;font:.84rem var(--fm);margin:0 0 8px}
.__meta__ span{border:1px solid var(--ln2);border-radius:99px;padding:2px 12px;color:var(--mu)}
.__legal__{display:block;margin-top:40px}
.__no__{display:block;font:.84rem var(--fm);color:var(--mu);margin:36px 0 -44px}
.__legal__ .__no__:first-child{margin-top:0}
.__legal__ h2{margin-top:56px}
.__pn__{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:56px}
.__pn__ a{display:block;border:1px solid var(--ln2);background:var(--sf);border-radius:var(--r);padding:18px 22px;min-width:0}
.__pn__ a:hover{border-color:var(--ac)}
.__pn__ a:last-child{text-align:right}
.__pn__ small{display:block;color:var(--mu);font-size:.8rem}
.__pn__ b{font-size:1.2rem;letter-spacing:-.01em;overflow-wrap:anywhere}
.__tc__{grid-area:toc;position:sticky;top:64px;align-self:start;padding:48px 0;font-size:.9rem}
.__tc__>a{display:block;padding:5px 0 5px 14px;color:var(--mu);border-left:2px solid var(--ln);overflow-wrap:anywhere}
.__tc__>a:hover{color:var(--fg);border-color:var(--ac)}
.__gl__{margin:32px 0 0;padding:16px;background:var(--sf);border:var(--bw) solid var(--ln);border-radius:var(--r);font-size:.88rem}
.__gl__ h6{margin:0 0 12px;font:650 .74rem var(--fb);letter-spacing:.1em;text-transform:uppercase;color:var(--mu)}
.__gl__ dt{color:var(--mu);font-size:.78rem}
.__gl__ dd{margin:0 0 10px;overflow-wrap:anywhere}
.__foot__{border-top:var(--bw) solid var(--ln);margin-top:40px;background:var(--band)}
.__fi__{max-width:var(--w);margin:0 auto;padding:48px clamp(16px,2.4vw,32px) 28px}
.__fg__{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:36px}
.__fg__ h6{margin:0 0 12px;font:650 .74rem var(--fb);letter-spacing:.1em;text-transform:uppercase;color:var(--mu)}
.__fg__ a,.__fg__ span{display:block;padding:3px 0;font-size:.94rem;overflow-wrap:anywhere}
.__fg__ a:hover{color:var(--ac)}
.__fg__ a.__logo__{display:flex;width:auto;padding:0}
.__fg__ p{font-size:.94rem;color:var(--mu);margin:10px 0 0;max-width:22em}
.__fg__ div{min-width:0}
.__fb__{margin-top:32px;padding-top:18px;border-top:1px solid var(--ln2);font-size:.88rem;color:var(--mu);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.__fb__ a:hover{color:var(--ac)}
.__nfw__{max-width:var(--w);margin:0 auto;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:clamp(20px,3.4vw,56px);padding:0 clamp(16px,2.4vw,32px);align-items:center}
.__nfm__{padding:64px 0}
.__nfn__{font:var(--fwh) clamp(8rem,24vw,22rem)/.8 var(--fh);letter-spacing:var(--lsh);color:var(--so);text-align:center}
.__btn__{display:inline-flex;align-items:center;gap:8px;padding:12px 20px;border-radius:var(--rs);background:var(--ac);color:var(--ai);font-weight:650}
.__btn__ .__ic__{width:1.1em;height:1.1em}
@media (max-width:1100px){
.__shell__{grid-template-columns:200px minmax(0,1fr);grid-template-areas:"side main"}
.__tc__{display:none}
.__logo__{width:200px}
}
@media (max-width:820px){
.__shell__{grid-template-columns:1fr;grid-template-areas:"side" "main";gap:0}
.__side__{position:static;display:flex;flex-wrap:wrap;gap:6px;padding:16px 0 0;border-bottom:1px solid var(--ln)}
.__side__ .__g__{margin:0;display:flex;flex-wrap:wrap;gap:6px}
.__side__ h6{display:none}
.__side__ a{background:var(--sf);border:1px solid var(--ln);margin:0}
.__co__,.__feat__,.__pn__,.__nfw__{grid-template-columns:1fr}
.__tn__{display:none}
.__logo__{width:auto}
.__fg__{grid-template-columns:1fr 1fr}
.__fg__>div:first-child{grid-column:1/-1}
.__main__ h2{font-size:1.6rem}
.__lead__{font-size:1.1rem}
.__main__{padding-top:32px}
.__tbl__ td:first-child{white-space:normal}

.__nfn__{display:none}
.__nfm__{padding:40px 0}
}
@media (max-width:720px){.__side__{display:none}}
@media (max-width:560px){.__tbl__ thead{display:none}.__tbl__ table,.__tbl__ tbody,.__tbl__ tr,.__tbl__ td{display:block;width:100%}.__tbl__ tr{padding:12px 0;border-bottom:1px solid var(--ln)}.__tbl__ td{border:0;padding:3px 14px;white-space:normal}.__fg__{grid-template-columns:1fr}.__bin__{gap:12px}.__ver__{font-size:.74rem;padding:2px 8px}}
{{if eq .Layout 1}}@media (min-width:1101px){.__shell__{grid-template-columns:236px minmax(0,1fr);grid-template-areas:"side toc" "side main"}.__tc__{position:static;padding:40px 0 0;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px}.__tc__ h6{margin:0 6px 0 0;width:100%}.__tc__>a{padding:4px 12px;border:1px solid var(--ln);border-radius:99px}.__tc__ .__gl__{display:none}.__main__{padding-top:28px}}
{{else if eq .Layout 2}}@media (min-width:1101px){.__shell__{grid-template-columns:minmax(0,1fr) 240px;grid-template-areas:"side side" "main toc"}.__side__{position:static;display:flex;flex-wrap:wrap;gap:6px 28px;padding:20px 0 0;border-bottom:1px solid var(--ln)}.__side__ .__g__{margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:2px 6px}.__side__ h6{margin:0 6px 0 0}.__main__{max-width:820px}.__tn__{display:none}.__mn__{display:none}}
{{end}}
