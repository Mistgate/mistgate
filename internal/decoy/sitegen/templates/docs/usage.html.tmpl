{{template "head" .}}<body>
{{template "header" .}}
<div class="__wrap__ __docs__">
{{if eq .Layout 0}}{{template "sidenav" .}}{{end}}<article class="__doc__">
<h1>{{.L.usage_h}}</h1>
{{range .L.usage}}<h2>{{.h}}</h2>
<p>{{.p}}</p>
<pre><code>{{.code}}</code></pre>
{{end}}<h2>{{.L.opts_h}}</h2>
<div class="__tbl__"><table>
<thead><tr><th>{{.L.opt_col}}</th><th>{{.L.desc_col}}</th></tr></thead>
<tbody>{{range .L.options}}<tr><td><code>{{.o}}</code></td><td>{{.d}}</td></tr>{{end}}</tbody>
</table></div>
</article>
{{if eq .Layout 1}}{{template "facts" .}}{{end}}</div>
{{template "footer" .}}
</body>
</html>
