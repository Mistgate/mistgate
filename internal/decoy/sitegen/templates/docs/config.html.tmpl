{{template "head" .}}<body>
{{template "header" .}}
<div class="__wrap__ __docs__">
{{template "sidenav" .}}<article class="__doc__">
<h1>{{.L.config_h}}</h1>
<p class="__lede__">{{.L.config_intro}}</p>
<h2>{{.L.config_file_h}}</h2>
<pre><code>{{.L.config_code}}</code></pre>
<div class="__tbl__"><table>
<thead><tr><th>{{.L.config_col_key}}</th><th>{{.L.config_col_default}}</th><th>{{.L.config_col_desc}}</th></tr></thead>
<tbody>{{range .L.config_rows}}<tr><td><code>{{.k}}</code></td><td><code>{{.v}}</code></td><td>{{.d}}</td></tr>{{end}}</tbody>
</table></div>
<p><a class="__btn__" href="{{(index .Nav 4).Href}}">{{.L.next}}: {{(index .Nav 4).Label}} {{icon "arrow"}}</a></p>
</article>
{{if eq .Layout 1}}{{template "facts" .}}{{end}}</div>
{{template "footer" .}}
</body>
</html>
