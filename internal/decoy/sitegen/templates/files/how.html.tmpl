{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__">
<div class="__pgh__"><span class="__sticker__">{{.L.kicker}}</span><h1><span class="__mk__">{{.L.how_h}}</span></h1><p class="__lead__">{{.L.how_intro}}</p></div>
<ol class="__rows__">{{range $i, $s := .L.steps}}<li class="__row__ __bx__"><b>{{add $i 1}}</b><div><h2>{{$s.h}}</h2><p>{{$s.p}}</p></div>{{if eq $i 0}}{{template "ill1" $}}{{else if eq $i 1}}{{template "ill2" $}}{{else}}{{template "ill3" $}}{{end}}</li>
{{end}}</ol>
<div class="__cta__"><h2>{{.L.nav_home}}</h2><a class="__btn__ __pk__" href="/">{{icon "upload"}}{{.L.pick}}</a></div>
</main>
{{template "footer" .}}
</body>
</html>
