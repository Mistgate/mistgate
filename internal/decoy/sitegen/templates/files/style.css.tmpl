{{template "base_vars" .}}{{template "base_core" .}}{{template "base_pages" .}}{{template "draw_css" .}}
{{$o := num "pl" 0 3}}:root{ {{if eq $o 0}}--p1:var(--ac);--p2:var(--a2);--p3:var(--oks);--p4:var(--was){{else if eq $o 1}}--p1:var(--a2);--p2:var(--was);--p3:var(--ac);--p4:var(--oks){{else if eq $o 2}}--p1:var(--oks);--p2:var(--ac);--p3:var(--was);--p4:var(--a2){{else}}--p1:var(--was);--p2:var(--oks);--p3:var(--a2);--p4:var(--ac){{end}};--line:var(--bw) solid var(--fg) }
h1,h2,h3,h4{color:var(--fg)}
h2{font-size:var(--t3)}
a{color:inherit}
.__top__{position:relative}
.__topin__{display:flex;align-items:center;justify-content:space-between;gap:20px;height:84px}
.__logo__{display:flex;align-items:center;gap:10px;min-width:0;color:var(--fg);font:var(--fwh) 1.5rem/1 var(--fh);letter-spacing:-.04em;text-decoration:none}
.__logo__ span{min-width:0;overflow:hidden;text-overflow:ellipsis}
.__logo__ .__mark__{width:34px;height:34px}
.__nav__{display:flex;gap:6px;font-weight:650}
.__nav__ a{padding:9px 16px;border:var(--bw) solid transparent;border-radius:99px;color:var(--fg);text-decoration:none}
.__nav__ a:hover{border-color:var(--fg)}
.__nav__ a[aria-current]{border-color:var(--fg);background:var(--ac)}
.__btn__{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:.72em 1.3em;border:var(--line);border-radius:var(--rs);background:var(--ac);color:var(--fg);font:800 1.05rem/1.2 var(--fb);box-shadow:4px 4px 0 var(--fg);text-decoration:none;cursor:pointer;transition:transform .12s,box-shadow .12s}
.__btn__:hover{transform:translate(-1px,-1px);box-shadow:6px 6px 0 var(--fg)}
.__btn__:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--fg)}
.__btn__:focus-visible{outline:3px solid var(--fg);outline-offset:3px}
.__btn__ .__ic__{stroke-width:3}
.__pk__{background:var(--a2)}
.__ghost__{background:var(--sf)}
.__mnb__{border:var(--line);border-radius:var(--rs);background:var(--sf);margin-right:0}
.__mnl__{background:var(--bg);border-bottom:var(--line);box-shadow:none}
.__mnl__ a{border-bottom:var(--bw) solid var(--fg);font-weight:700}
.__mnl__ a[aria-current]{color:var(--fg);background:var(--ac)}
.__sticker__{display:inline-block;padding:6px 16px;border:var(--line);border-radius:99px;background:var(--p4);font:700 .85rem var(--fm);letter-spacing:.06em;text-transform:uppercase;transform:rotate(-2deg)}
h1{margin:22px 0 20px;font-size:calc(var(--t5)*.8);line-height:1.06}
.__mk__{padding:.03em .14em;margin:0 -.06em;border-radius:.14em;background:var(--a2);-webkit-box-decoration-break:clone;box-decoration-break:clone}
.__lead__{max-width:28em;margin:0 0 28px;color:var(--mu);font-size:clamp(18px,1.6vw,23px)}
.__fine__{font:600 .92rem var(--fm)}
.__bx__{border:var(--line);border-radius:var(--r);background:var(--sf);box-shadow:var(--sh)}
.__hero__ > *{min-width:0}
.__hero__{display:grid;align-items:center;gap:clamp(28px,4vw,64px);padding-top:clamp(20px,3vw,48px);padding-bottom:clamp(48px,6vw,88px)}
.__dz__{position:relative;padding:clamp(24px,3vw,40px);border:3px dashed var(--fg);border-radius:var(--rb);background:var(--sf);box-shadow:8px 8px 0 var(--fg);text-align:center}
.__tag__{position:absolute;top:-18px;right:24px;padding:4px 14px;border:var(--line);border-radius:99px;background:var(--p3);font:700 .88rem var(--fm);transform:rotate(3deg)}
.__drop__{display:flex;flex-direction:column;align-items:center;gap:8px;padding:8px;border-radius:var(--r);cursor:pointer}
.__drop__:focus-visible{outline:3px solid var(--fg);outline-offset:4px}
.__over__{background:var(--so)}
.__dh__{margin-top:8px;font:var(--fwh) var(--t2)/1.05 var(--fh);letter-spacing:-.04em;overflow-wrap:anywhere}
.__dhint__{margin-bottom:14px;color:var(--mu)}
.__stack__{width:min(100%,340px);height:auto}
.__sk__{fill:none;stroke:var(--fg);stroke-width:3px;stroke-linejoin:round;stroke-linecap:round}
.__sk__ *{vector-effect:non-scaling-stroke}
.__f1__{fill:var(--p1)}
.__f2__{fill:var(--p2)}
.__f3__{fill:var(--p3)}
.__f4__{fill:var(--p4)}
.__fw__{fill:var(--sf)}
.__state__{padding:12px 4px;text-align:left}
.__fileline__{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;margin-bottom:14px;font-weight:700;overflow-wrap:anywhere}
.__fsize__{font-family:var(--fm)}
.__bar__{height:16px;overflow:hidden;border:var(--line);border-radius:99px;background:var(--bg)}
.__bar__ i{display:block;width:0;height:100%;background:var(--ac);border-right:var(--line);transition:width 1.4s ease}
.__msg__{margin:16px 0 14px;font-weight:600}
.__fail__{padding:.5em .8em;border:var(--line);border-radius:var(--rs);background:color-mix(in srgb,var(--bd) 22%,var(--sf))}
.__feats__{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;padding-top:clamp(24px,3vw,40px);padding-bottom:clamp(56px,7vw,104px)}
.__ft__{padding:28px;border-radius:var(--rb)}
.__ft__:nth-child(1){background:var(--p1);transform:rotate(-1deg)}
.__ft__:nth-child(2){background:var(--p2);transform:rotate(1deg)}
.__ft__:nth-child(3){background:var(--p3);transform:rotate(-.6deg)}
.__fi__{display:block;margin-bottom:46px}
.__fi__ .__ic__{width:44px;height:44px;stroke-width:1.7}
.__ft__ h3{margin:0 0 8px;font-size:var(--t1)}
.__ft__ p{margin:0}
.__band__{padding:clamp(56px,7vw,104px) 0;border-radius:calc(var(--rb)*1.6) calc(var(--rb)*1.6) 0 0;background:var(--fg);color:var(--bg)}
.__band__ h2,.__band__ h3{color:inherit}
.__sh__{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px 24px;margin-bottom:44px}
.__sh__ h2{margin:0;font-size:var(--t4);line-height:.95}
.__sh__ p{max-width:20em;margin:0;color:color-mix(in srgb,var(--bg) 75%,var(--fg));font-size:1.1rem}
.__steps__{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:0;padding:0;list-style:none}
.__sc__{padding:30px;border:var(--line);border-color:var(--bg);border-radius:var(--rb);background:var(--bg);color:var(--fg)}
.__sc__ b,.__row__ > b{display:grid;place-items:center;width:64px;height:64px;margin-bottom:28px;border:var(--line);border-radius:50%;font:var(--fwh) 1.9rem/1 var(--fh)}
.__sc__:nth-child(1) b,.__row__:nth-child(1) > b{background:var(--p1)}
.__sc__:nth-child(2) b,.__row__:nth-child(2) > b{background:var(--p2)}
.__sc__:nth-child(3) b,.__row__:nth-child(3) > b{background:var(--p4)}
.__sc__ h3{margin:0 0 8px;font-size:var(--t2)}
.__sc__ p{margin:0;color:var(--mu)}
.__morep__{margin:36px 0 0}
.__inv__{border-color:var(--bg);box-shadow:4px 4px 0 var(--bg);background:var(--fg);color:var(--bg)}
.__inv__:hover{box-shadow:6px 6px 0 var(--bg)}
.__lim__{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:clamp(28px,5vw,80px);padding-top:clamp(56px,7vw,104px);padding-bottom:clamp(56px,7vw,104px)}
.__lim__ > div,.__lg2__ > div{min-width:0}
.__sh2__{margin-bottom:28px}
.__sh2__ h2,.__lg2__ h2{margin:0 0 16px;font-size:var(--t3);line-height:1}
.__sh2__ p{margin:14px 0 0;color:var(--mu)}
.__big__{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.__bg__{display:flex;flex-direction:column;justify-content:space-between;gap:20px;min-width:0;padding:24px;border-radius:var(--rb)}
.__bg__:nth-child(1){background:var(--p1)}
.__bg__:nth-child(2){background:var(--p3)}
.__bg__:nth-child(3){background:var(--p2)}
.__bg__:nth-child(4){background:var(--p4)}
.__bg__ b{font:var(--fwh) clamp(2rem,3.6vw,3.2rem)/1 var(--fh);letter-spacing:-.05em;overflow-wrap:anywhere}
.__bgs__ b{font-size:clamp(1.4rem,2vw,1.9rem);letter-spacing:-.03em}
.__bg__ span{font-weight:650}
.__tbx__{overflow:hidden}
.__tbx__ table{width:100%;border-collapse:collapse}
.__tbx__ th,.__tbx__ td{padding:16px 22px;border-top:var(--line);text-align:left;vertical-align:top}
.__tbx__ tr:first-child > *{border-top:0}
.__tbx__ th{font-weight:500}
.__tbx__ td{text-align:right;font-weight:750}
.__qa__{margin-bottom:14px;border:var(--line);border-radius:var(--r);background:var(--sf);box-shadow:4px 4px 0 var(--fg)}
.__qa__ summary{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 24px;font:800 1.15rem/1.3 var(--fb);letter-spacing:-.01em;list-style:none;cursor:pointer}
.__qa__ summary::-webkit-details-marker{display:none}
.__qa__ summary:focus-visible{outline:3px solid var(--fg);outline-offset:3px;border-radius:var(--r)}
.__qa__ i{display:grid;flex:none;place-items:center;width:32px;height:32px;border:var(--line);border-radius:50%;background:var(--ac);font:900 1.1rem/1 var(--fb);font-style:normal}
.__qa__ i::before{content:"+"}
.__qa__[open] i::before{content:"–"}
.__qa__ p{margin:0;padding:0 24px 22px;color:var(--mu)}
.__pgh__{padding:clamp(20px,3vw,48px) 0 clamp(36px,5vw,72px)}
.__pgh__ .__lead__{margin:0}
.__rows__{margin:0;padding:0;list-style:none}
.__row__{display:grid;grid-template-columns:84px minmax(0,1fr) minmax(0,1fr);align-items:center;gap:clamp(20px,3vw,48px);margin-bottom:28px;padding:32px}
.__row__ > b{width:84px;height:84px;margin:0;font-size:2.7rem}
.__row__:nth-child(2){background:var(--bg)}
.__row__ h2{margin:0 0 8px;font-size:var(--t3);line-height:1}
.__row__ p{margin:0;font-size:1.2rem;color:var(--mu)}
.__il__{width:100%;max-width:340px;height:auto;justify-self:end}
.__cta__{padding:clamp(40px,6vw,88px) 0;text-align:center}
.__cta__ h2{margin:0 0 24px;font-size:var(--t4);line-height:.95}
.__big4__{grid-template-columns:repeat(4,1fr);margin-bottom:clamp(40px,5vw,64px)}
.__lg2__{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:clamp(24px,4vw,64px)}
.__foot__{margin-top:0;padding:56px 0 0;overflow:hidden;border-top:var(--line);background:var(--ac);color:var(--fg)}
.__fg__{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:36px}
.__fg__ h4{margin:0 0 14px;font:700 .9rem var(--fm);letter-spacing:.06em;text-transform:uppercase}
.__fg__ a{display:block;padding:4px 0;font-weight:600;text-decoration:none}
.__fg__ a:hover{text-decoration:underline}
.__fg__ .__logo__{display:flex;padding:0}
.__fg__ p{max-width:20em;margin:12px 0 0;font-weight:600}
.__fine2__{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 24px;margin-top:40px;font:600 .88rem var(--fm)}
{{$n := len .Brand}}.__wm__{margin:36px 0 -.12em;font:var(--fwh) min(200px,calc(150vw/{{$n}}))/.8 var(--fh);letter-spacing:-.07em;white-space:nowrap}
.__lg__{padding-top:clamp(28px,4vw,56px);padding-bottom:clamp(40px,5vw,72px)}
.__lgt__ h1{font-size:var(--t4)}
.__lgt__{counter-reset:s}
.__lgt__ h2{display:flex;align-items:center;gap:14px;counter-increment:s;margin-top:1.6em;font-size:var(--t2)}
.__lgt__ h2::before{content:counter(s);display:grid;flex:none;place-items:center;width:44px;height:44px;border:var(--line);border-radius:50%;background:var(--p1);font:var(--fwh) 1.1rem/1 var(--fh)}
.__lgt__ h2:nth-of-type(4n+2)::before{background:var(--p2)}
.__lgt__ h2:nth-of-type(4n+3)::before{background:var(--p3)}
.__lgt__ h2:nth-of-type(4n+4)::before{background:var(--p4)}
.__toc__{border:var(--line);border-radius:var(--r);background:var(--sf);box-shadow:var(--sh)}
.__toc__ h2{color:var(--fg);font-family:var(--fm)}
.__toc__ li::before{color:var(--fg);font-weight:700}
.__code__{color:var(--fg);text-shadow:6px 6px 0 var(--p1)}
.__nfa__{border:var(--line);box-shadow:8px 8px 0 var(--fg);transform:rotate(2deg)}
{{if eq .Layout 0}}.__hero__{grid-template-columns:1.05fr 1fr}
{{else if eq .Layout 1}}.__hc__{grid-template-columns:1fr;justify-items:center;text-align:center;padding-top:clamp(20px,3vw,40px)}
.__hc__ .__lead__{margin-left:auto;margin-right:auto}
.__hc__ .__mk__{background:var(--p1)}
.__hc__ .__dz__{width:100%;max-width:880px}
.__hc__ .__drop__{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);align-items:center;gap:6px 36px;text-align:left}
.__hc__ .__stack__{grid-row:1/span 4;width:100%;max-width:none}
.__hc__ .__drop__ > :not(.__stack__){grid-column:2;justify-self:start}
.__hc__ .__fine__{margin-top:4px}
{{else}}.__hb__{margin-bottom:clamp(40px,5vw,72px);border-bottom:var(--line);background:var(--p2)}
.__hb__ .__hero__{grid-template-columns:1fr 1.05fr;padding-top:clamp(40px,5vw,72px);padding-bottom:clamp(56px,6vw,96px)}
.__hb__ .__mk__{background:var(--sf)}
.__hb__ .__lead__{color:var(--fg)}
.__pol__{max-width:320px;margin:0 0 20px;padding:10px 10px 0;border:var(--line);border-radius:var(--rs);background:var(--sf);box-shadow:var(--sh);transform:rotate(-2deg);line-height:0}
.__pol__ img,.__pol__ svg{width:100%;height:auto;border-radius:calc(var(--rs) - 4px)}
.__pol__::after{content:"";display:block;height:30px}
{{end}}@media (max-width:900px){.__nav__{display:none}.__mn__{display:block}.__hero__,.__lim__,.__lg2__{grid-template-columns:minmax(0,1fr)}.__steps__,.__feats__{grid-template-columns:1fr}.__fg__{grid-template-columns:1fr 1fr}.__fb__{grid-column:1/-1}.__band__{border-radius:28px 28px 0 0}.__ft__:nth-child(n){transform:none}.__row__{grid-template-columns:64px minmax(0,1fr)}.__row__ > b{width:64px;height:64px;font-size:2rem}.__il__{grid-column:1/-1;justify-self:start;max-width:260px}.__big4__{grid-template-columns:1fr 1fr}.__fi__{margin-bottom:24px}.__hc__ .__drop__{display:flex;text-align:center}.__hc__ .__stack__{width:min(100%,340px)}.__hc__ .__drop__ > :not(.__stack__){justify-self:center}.__hb__ .__hero__{padding-bottom:56px}}
@media (max-width:560px){.__topbtn__{display:none}.__bx__,.__qa__{box-shadow:4px 4px 0 var(--fg)}.__dz__{box-shadow:5px 5px 0 var(--fg)}.__big__,.__big4__{grid-template-columns:1fr}.__sh__{margin-bottom:28px}.__row__{padding:22px;gap:16px 18px}.__sc__{padding:24px}.__tbx__ th,.__tbx__ td{padding:14px 16px}.__qa__ summary{padding:16px 18px}.__qa__ p{padding:0 18px 18px}h1{font-size:clamp(2rem,10.4vw,var(--t5));overflow-wrap:anywhere;hyphens:auto}.__lgt__ h1{font-size:clamp(2rem,9vw,var(--t4))}}
@media (max-width:720px){.__lg__{grid-template-columns:minmax(0,1fr)}}
.__lg__ > *{min-width:0}
.__lgt__ h1,.__lgt__ h2{overflow-wrap:anywhere;hyphens:auto}
