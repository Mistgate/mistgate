{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __lg__">
<article class="__lgt__">
<h1>{{.L.privacy_h}}</h1>
<p class="__mu__">{{.L.privacy_intro}}</p>
{{range $i, $s := .L.privacy}}<h2 id="s{{add $i 1}}">{{$s.h}}</h2>
<p>{{$s.p}}</p>
{{end}}</article>
<aside class="__toc__">
<h2>{{.L.toc_h}}</h2>
<ol>{{range $i, $s := .L.privacy}}<li><a href="#s{{add $i 1}}">{{$s.h}}</a></li>{{end}}</ol>
</aside>
</main>
{{template "footer" .}}
</body>
</html>
