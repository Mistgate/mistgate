{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __pf__">
<article class="__piece__">
<p class="__mu__"><a href="{{(index .Nav 1).Href}}">{{.L.work_back}}</a></p>
<h1>{{.Page.Item.title}}</h1>
<figure class="__big__"><img src="{{.Page.Item.img}}" alt="{{.Page.Item.title}}" width="{{.Page.Item.w}}" height="{{.Page.Item.h}}"></figure>
<p class="__lede__">{{.Page.Item.note}}</p>
<p>{{.Page.Item.text}}</p>
<p class="__mu__">{{.Page.Item.caption}}</p>
<p><a class="__btn__" href="{{(index .Nav 3).Href}}">{{.L.work_ask}}</a></p>
</article>
<h2 class="__sectitle__">{{.L.work_more}}</h2>
<div class="__others__">{{range .Lists.works}}{{if ne .slug $.Page.Item.slug}}<a href="{{.href}}"><img src="{{.img}}" alt="{{.title}}" width="{{.w}}" height="{{.h}}" loading="lazy"><span>{{.title}}</span></a>{{end}}{{end}}</div>
</main>
{{template "footer" .}}
</body>
</html>
