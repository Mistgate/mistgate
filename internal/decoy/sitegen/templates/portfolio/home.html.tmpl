{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __pf__">
<section class="__hero__">
<h1>{{.Brand}}</h1>
<p class="__lede__">{{.L.intro}}</p>
</section>
<h2 class="__sectitle__">{{.L.sel_h}}</h2>
<div class="__gal__">
{{$lim := 6}}{{if eq .Layout 2}}{{$lim = 7}}{{end}}{{range $i, $w := .Lists.works}}{{if lt $i $lim}}<figure class="__fig__">
<a class="__pic__" href="{{$w.href}}"><img src="{{$w.img}}" alt="{{$w.title}}" width="{{$w.w}}" height="{{$w.h}}" loading="lazy"></a>
<figcaption><strong><a href="{{$w.href}}">{{$w.title}}</a></strong><span>{{$w.caption}}</span></figcaption>
</figure>
{{end}}{{end}}</div>
<p class="__more__"><a class="__btn__ __ghost__" href="{{(index .Nav 1).Href}}">{{.L.all_work}} {{icon "arrow"}}</a></p>
</main>
{{template "footer" .}}
</body>
</html>
