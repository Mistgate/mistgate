{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __page__">
<h1>{{.L.install_h}} {{.Brand}}</h1>
<p class="__lede__">{{.L.install_intro}}</p>
<h2>{{.L.pkg_h}}</h2>
<div class="__tbl__"><table>
<tbody>{{range .L.pkgs}}<tr><th scope="row">{{.s}}</th><td><code>{{.c}}</code></td></tr>{{end}}</tbody>
</table></div>
<p class="__mu__">{{.L.pkg_note}}</p>
<h2>{{.L.src_h}}</h2>
<p>{{.L.src_intro}}</p>
{{$v := (index .Lists.releases 0).version}}<pre><code>tar xf {{.V.cmd}}-{{$v}}.tar.gz
cd {{.V.cmd}}-{{$v}}
make
sudo make install</code></pre>
<h2>{{.L.sums_h}}</h2>
<p>{{.L.sums_intro}}</p>
<div class="__tbl__"><table>
<thead><tr><th>{{.L.col_ver}}</th><th>{{.L.col_date}}</th><th>{{.L.col_sum}}</th></tr></thead>
<tbody>{{range $i, $r := .Lists.releases}}<tr><td>{{$r.version}}</td><td>{{$r.date}}</td><td><code class="__sum__">{{hexs (printf "sum%d" $i) 64}}</code></td></tr>{{end}}</tbody>
</table></div>
<h2>{{.L.licence_h}}</h2>
<p>{{.L.licence_p}}</p>
</main>
{{template "footer" .}}
</body>
</html>
