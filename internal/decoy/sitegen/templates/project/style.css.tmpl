{{template "base_vars" .}}{{template "base_core" .}}{{template "base_pages" .}}{{template "draw_css" .}}
html{background:var(--bg)}
body{max-width:var(--w);width:100%;margin:0 auto;border-left:var(--bw) solid var(--ln);border-right:var(--bw) solid var(--ln);overflow-x:hidden}
a{color:inherit;text-decoration:none}
h1,h2,h3{font-weight:var(--fwh)}
.__ln__{border-top:var(--bw) solid var(--ln)}
.__top__{position:relative;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 clamp(16px,2.6vw,36px);height:64px;border-bottom:var(--bw) solid var(--ln)}
.__logo__{display:flex;align-items:center;gap:8px;font:700 1.2rem var(--fh);letter-spacing:var(--lsh)}
.__logo__ i{display:block;width:10px;height:20px;background:var(--ac)}
.__nav__{display:flex;gap:4px}
.__nav__ a{padding:6px 12px;color:var(--mu)}
.__nav__ a::before{content:"["}
.__nav__ a::after{content:"]"}
.__nav__ a:hover{color:var(--fg)}
.__nav__ a[aria-current]{color:var(--ac)}
.__mnb__{color:var(--fg)}
.__mnl__{background:var(--bg);box-shadow:none;border-bottom:var(--bw) solid var(--ln)}
.__mnl__ a{font-family:var(--fm);border-color:var(--ln)}
.__eb__{display:inline-flex;align-items:center;gap:8px;color:var(--ac);font:var(--fsl) var(--fl);letter-spacing:var(--lsl);text-transform:var(--ttl)}
.__eb__ .__ic__{width:1.1em;height:1.1em}
.__sub__{margin:0;color:var(--mu);max-width:36em}
.__mb__{margin-bottom:28px}
.__mt__{margin-top:24px}
.__ph__{padding:clamp(28px,4vw,64px) clamp(16px,2.6vw,36px)}
.__ph__ h1,.__hd__ h1{font-size:var(--t5);line-height:.94;margin:16px 0 20px}
h1 em{font-style:normal;background:var(--ac);color:var(--ai);padding:0 .08em}
.__sec__{padding:clamp(28px,4vw,56px) clamp(16px,2.6vw,36px)}
.__nopb__{padding-bottom:0}
.__sec__ h2,.__ins__ h2,.__rmw__ h2{font-size:var(--t4);line-height:1;margin:0 0 14px}
.__hero__{display:grid;grid-template-columns:1.15fr 1fr;grid-template-areas:"hh term" "hb term"}
.__hh__{grid-area:hh;padding:clamp(28px,5vw,72px) clamp(16px,2.6vw,36px) 0}
.__hb__{grid-area:hb;display:flex;flex-direction:column;justify-content:space-between;gap:32px;padding:24px clamp(16px,2.6vw,36px) clamp(32px,5vw,64px)}
.__hh__ h1{font-size:var(--t5);line-height:.94;margin:20px 0 0}
.__hero__>.__term__{grid-area:term;border-left:var(--bw) solid var(--ln)}
.__lead__{margin:0;max-width:34em;color:var(--mu);font-size:1.08rem}
.__bd__{display:flex;flex-wrap:wrap;gap:8px}
.__bd__ span{border:1px solid var(--ln2);padding:3px 10px;font-size:.84rem}
.__bd__ b{color:var(--ac);font-weight:600}
.__term__{background:var(--sf);display:flex;flex-direction:column;min-width:0}
.__tb__{display:flex;gap:8px;align-items:center;padding:12px 16px;border-bottom:var(--bw) solid var(--ln);color:var(--mu);font-size:.84rem}
.__tb__ i{width:11px;height:11px;border-radius:50%;border:1px solid var(--ln2)}
.__tb__ span{margin-left:8px}
.__term__ pre{margin:0;padding:24px;font:inherit;font-family:var(--fm);font-size:.94rem;line-height:1.85;overflow:auto;flex:1;border:0;background:none}
.__boxed__{border:var(--bw) solid var(--ln)}
.__boxed__ pre{padding:20px 24px}
.__dhm__{color:var(--ac);font-weight:400}
.__dhc__,.__dhp__{color:var(--mu)}
.__dhf__{color:var(--wa)}
.__dhn__{color:var(--a2)}
.__dhs__{color:var(--a2)}
.__cur__{display:inline-block;width:9px;height:17px;background:var(--ac);vertical-align:-3px}
.__ins__{display:grid;grid-template-columns:1fr 1.6fr;border-top:var(--bw) solid var(--ln)}
.__ins__>div{padding:clamp(24px,3.4vw,48px) clamp(16px,2.6vw,36px);min-width:0}
.__ins__>div:first-child{border-right:var(--bw) solid var(--ln)}
.__cmd__{display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px solid var(--ac);padding:14px 18px;margin-bottom:20px;color:var(--ac);font-family:var(--fm)}
.__cmd__ small{flex:none;color:var(--ai);background:var(--ac);padding:2px 10px;font:var(--fsl) var(--fl);letter-spacing:var(--lsl);text-transform:var(--ttl)}
.__cmd__ .__dhm__,.__cmd__ .__dhp__{color:var(--ac)}
.__cmd__ span:first-child{min-width:0;overflow-wrap:anywhere}
.__pk__{border-top:var(--bw) solid var(--ln)}
.__pk__ div{display:grid;grid-template-columns:200px minmax(0,1fr);gap:16px;padding:12px 0;border-bottom:1px solid var(--ln);font-size:.9rem;font-family:var(--fm)}
.__pk__ span:first-child{color:var(--mu)}
.__pk__ span{overflow-wrap:anywhere}
.__fe__{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:var(--bw) solid var(--ln)}
.__fe__>div{padding:clamp(24px,3vw,44px) clamp(16px,2.6vw,36px) clamp(32px,4vw,56px);border-right:var(--bw) solid var(--ln);display:flex;flex-direction:column;gap:56px}
.__fe__>div:last-child{border:0}
.__fe__ b{font:700 var(--t5) var(--fh);letter-spacing:var(--lsh);color:var(--ln2);line-height:.8}
.__fe__ h3{margin:0 0 8px;font-size:1.3rem}
.__fe__ p{margin:0;color:var(--mu)}
.__rel__{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;border-top:var(--bw) solid var(--ln);padding:28px 0}
.__rel__ h3{margin:0;font-size:1.6rem}
.__rel__ h3 span{display:block;font:400 .8rem var(--fb);letter-spacing:0;color:var(--mu);margin-top:4px}
.__notes__{list-style:none;margin:0;padding:0}
.__notes__ li{display:grid;grid-template-columns:96px minmax(0,1fr);gap:14px;padding:5px 0;align-items:baseline}
.__k__{display:inline-block;font:var(--fsl) var(--fl);letter-spacing:var(--lsl);text-transform:var(--ttl);padding:1px 8px;text-align:center;border:1px solid var(--ln2);color:var(--fg);overflow-wrap:anywhere}
.__kadd__{background:var(--ac);color:var(--ai);border-color:var(--ac)}
.__kfix__{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.__more__{margin:20px 0 0;color:var(--ac)}
.__rm__{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
.__rmw__{border-top:var(--bw) solid var(--ln)}
.__rmw__ .__rm__{margin-top:32px;border-top:var(--bw) solid var(--ln)}
.__rm__>div{padding:clamp(20px,3vw,40px) clamp(16px,2.6vw,36px);border-right:var(--bw) solid var(--ln)}
.__rm__>div:last-child{border:0}
.__rm__ h3{margin:0 0 18px;font:var(--fsl) var(--fl);font-weight:700;letter-spacing:var(--lsl);text-transform:var(--ttl);display:flex;align-items:center;gap:10px}
.__rm__ h3 i{width:10px;height:10px;display:block;background:var(--ac)}
.__rm__>div:nth-child(2) h3 i{background:var(--fg)}
.__rm__>div:nth-child(3) h3 i{background:var(--ln2)}
.__rm__ ul{margin:0;padding:0}
.__rm__ li{list-style:none;padding:10px 0;border-top:1px solid var(--ln)}
.__lic__{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:clamp(28px,4vw,56px) clamp(16px,2.6vw,36px);background:var(--ac);color:var(--ai)}
.__lic__ b{font:700 var(--t4)/.95 var(--fh);letter-spacing:var(--lsh)}
.__lic__ span{max-width:22em}
.__foot__{padding:44px clamp(16px,2.6vw,36px) 0;overflow:hidden;border-top:var(--bw) solid var(--ln)}
.__fg__{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:32px}
.__fg__ h6{margin:0 0 12px;font:400 var(--fsl) var(--fl);letter-spacing:var(--lsl);text-transform:var(--ttl);color:var(--mu)}
.__fg__ a,.__fg__ span{display:block;padding:3px 0}
.__fg__ a:hover{color:var(--ac)}
.__fg__ a.__logo__{display:flex;padding:0}
.__fg__ p{color:var(--mu);margin:12px 0 0;max-width:24em}
.__fg__ div{min-width:0;overflow-wrap:anywhere}
.__wm__{font:700 clamp(48px,14.4vw,200px)/.82 var(--fh);letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1.5px var(--ln2);margin:44px 0 -.1em;white-space:nowrap}
.__fb__{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--mu);font-size:.84rem;border-top:var(--bw) solid var(--ln);padding:16px clamp(16px,2.6vw,36px)}
.__rl__{display:grid;grid-template-columns:240px 28px minmax(0,1fr);gap:0 24px;padding:0 0 48px}
.__v__{text-align:right;padding-top:2px}
.__v__ h2{margin:0;font-size:2.1rem;line-height:1}
.__v__ span{display:block;font-size:.8rem;color:var(--mu);margin-top:6px}
.__dt__{position:relative}
.__dt__::before{content:"";position:absolute;left:13px;top:6px;bottom:-54px;width:1px;background:var(--ln)}
.__rl__:last-child .__dt__::before{display:none}
.__dt__ i{position:absolute;left:7px;top:8px;width:13px;height:13px;background:var(--bg);border:2px solid var(--ac);display:block}
.__rl__:first-child .__dt__ i{background:var(--ac)}
.__rl__ .__notes__{border:1px solid var(--ln);background:var(--sf)}
.__rl__ .__notes__ li{padding:12px 18px;border-top:1px solid var(--ln)}
.__rl__ .__notes__ li:first-child{border-top:0}
.__src__{display:inline-block;margin:12px 0 0;color:var(--ac)}
.__hd__{display:grid;grid-template-columns:1.4fr 1fr;border-bottom:var(--bw) solid var(--ln)}
.__hd__>div{padding:clamp(28px,4vw,56px) clamp(16px,2.6vw,36px);min-width:0}
.__hd__>div:last-child{border-left:var(--bw) solid var(--ln);background:var(--sf)}
.__hd__ h1{font-size:clamp(3.4rem,10vw,9rem);margin:10px 0 8px}
.__kv__{display:grid;grid-template-columns:130px minmax(0,1fr);gap:12px;padding:12px 0;border-bottom:1px solid var(--ln);font-size:.9rem}
.__kv__ span:first-child{color:var(--mu)}
.__kv__:last-child{border:0}
.__bign__{margin:20px 0 0;border:1px solid var(--ln);background:var(--sf)}
.__bign__ .__notes__ li{padding:14px 20px;border-top:1px solid var(--ln)}
.__bign__ .__notes__ li:first-child{border-top:0}
.__tw__{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:.9rem}
th{text-align:left;font:400 var(--fsl) var(--fl);letter-spacing:var(--lsl);text-transform:var(--ttl);color:var(--mu);padding:10px 14px;border-bottom:var(--bw) solid var(--ln)}
td{padding:16px 14px;border-bottom:1px solid var(--ln);vertical-align:top}
td.__nm__,td.__nm__ a{color:var(--ac);white-space:nowrap}
td.__hx__{min-width:21em;color:var(--mu);word-break:break-all;font-family:var(--fm);font-size:.8rem;line-height:1.5;max-width:520px}
td.__dm__{color:var(--mu)}
td.__ar__{text-align:right}
td.__ar__ a{color:var(--ac)}
.__cols__{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:28px;border-top:var(--bw) solid var(--ln)}
.__cols__>div{padding:clamp(20px,3vw,40px) clamp(16px,2.6vw,36px);border-right:var(--bw) solid var(--ln);min-width:0}
.__cols__>div:last-child{border:0}
.__cols__ ul{margin:0;padding:0}
.__cols__ li{list-style:none;padding:10px 0;border-top:1px solid var(--ln);overflow-wrap:anywhere;font-family:var(--fm);font-size:.9rem}
.__cols__ h3{margin:0 0 16px;font:700 var(--fsl) var(--fl);letter-spacing:var(--lsl);text-transform:var(--ttl)}
.__nfw__{display:grid;grid-template-columns:1.1fr 1fr;min-height:640px}
.__nl__{padding:clamp(28px,5vw,72px) clamp(16px,2.6vw,36px);border-right:var(--bw) solid var(--ln);display:flex;flex-direction:column;justify-content:space-between;gap:40px;min-width:0}
.__nl__ h1{font-size:var(--t5);line-height:.94;margin:16px 0 20px}
.__nfn__{font:700 clamp(120px,24vw,360px)/.78 var(--fh);color:transparent;-webkit-text-stroke:2px var(--ac)}
.__cta__{margin:28px 0 0}
.__btn__{display:inline-block;background:var(--ac);color:var(--ai);padding:12px 22px;font-weight:700}
@media (max-width:900px){
.__hero__{grid-template-columns:1fr;grid-template-areas:"hh" "hb" "term"}
.__hero__>.__term__{border-left:0;border-top:var(--bw) solid var(--ln)}
.__ins__,.__fe__,.__rm__,.__cols__,.__hd__,.__nfw__{grid-template-columns:1fr}
.__ins__>div:first-child,.__fe__>div,.__rm__>div,.__cols__>div,.__nl__{border-right:0;border-bottom:var(--bw) solid var(--ln)}
.__hd__>div:last-child{border-left:0}
.__fe__>div{gap:20px}
.__rel__{grid-template-columns:1fr;gap:12px}
.__rl__{grid-template-columns:1fr;gap:12px;padding-bottom:32px}
.__dt__{display:none}
.__v__{text-align:left}
.__fg__{grid-template-columns:1fr 1fr}
.__fg__>div:first-child{grid-column:1/-1}
.__lic__{flex-direction:column;align-items:flex-start}
.__pk__ div{grid-template-columns:1fr;gap:2px}
.__nfw__{min-height:0}
}
@media (max-width:720px){.__nav__{display:none}}
@media (max-width:560px){.__notes__ li{grid-template-columns:1fr;gap:4px}.__notes__ .__k__{justify-self:start}.__fg__{grid-template-columns:1fr}.__kv__{grid-template-columns:100px minmax(0,1fr)}}
{{if eq .Layout 1}}@media (min-width:901px){.__hero__{grid-template-columns:1fr 1fr;grid-template-areas:"hh hh" "hb term"}.__hh__ h1{font-size:var(--t5);max-width:14em}.__hh__{padding-bottom:8px}.__hero__>.__term__{border-top:var(--bw) solid var(--ln)}}
{{else if eq .Layout 2}}@media (min-width:901px){.__hero__{grid-template-columns:1fr 1.15fr;grid-template-areas:"term hh" "term hb"}.__hero__>.__term__{border-left:0;border-right:var(--bw) solid var(--ln)}.__hh__ h1{font-size:var(--t4)}}
{{end}}
