{{define "header"}}<header class="__top__">
<a class="__logo__" href="/">{{.V.cmd}}<i></i></a>
<nav class="__nav__" aria-label="{{.L.nav_label}}">{{range .Nav}}<a href="{{.Href}}"{{if .Cur}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
{{template "menu" .}}
</header>{{end}}
{{define "footer"}}<footer class="__foot__">
<div class="__fg__">
<div><a class="__logo__" href="/">{{.V.cmd}}<i></i></a><p>{{.L.desc}}</p></div>
<div><h6>{{.L.nav_label}}</h6>{{range .Nav}}<a href="{{.Href}}">{{.Label}}</a>{{end}}</div>
<div><h6>{{.L.nav_changelog}}</h6><a href="{{(index .Lists.releases 0).href}}">{{.L.latest_h}}</a><a href="{{(index .Nav 1).Href}}">{{.L.all_releases}}</a><a href="{{(index .Nav 2).Href}}">{{.L.src_h}}</a></div>
<div><h6>{{.L.nav_roadmap}}</h6>{{range .L.now}}<span>{{.}}</span>{{end}}{{range .L.next}}<span>{{.}}</span>{{end}}</div>
</div>
<div class="__wm__" aria-hidden="true">{{.V.cmd}}</div>
</footer>
<div class="__fb__"><span>{{.L.footer}}</span><span>© {{.Year}} {{.Brand}}</span></div>{{end}}
{{define "notes"}}<ul class="__notes__">{{range .notes}}<li><span class="__k__ __k{{.c}}__">{{.k}}</span><span>{{.t}}</span></li>{{end}}</ul>{{end}}
{{define "tbody"}}<pre><code>{{hl (printf "$ %s" (index .L.pkgs 0).c) "sh"}}
{{hl (printf "$ %s" .L.ver_cmd) "sh"}}
{{hl (printf "%s %s" .V.cmd (index .Lists.releases 0).version) "out"}}
{{hl (printf "$ %s" .L.quick) "sh"}}
{{hl "$ " "sh"}}<span class="__cur__"></span></code></pre>{{end}}
{{define "tbar"}}<div class="__tb__"><i></i><i></i><i></i><span>{{.L.term_path}}</span></div>{{end}}
