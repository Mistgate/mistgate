{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __page__">
<h1>{{.L.changelog_h}}</h1>
<p class="__lede__">{{.L.changelog_intro}}</p>
{{range .Lists.releases}}<article class="__rel__">
<h2><a href="{{.href}}">{{.version}}</a> <span class="__mu__"><time datetime="{{.date_iso}}">{{.date}}</time></span></h2>
