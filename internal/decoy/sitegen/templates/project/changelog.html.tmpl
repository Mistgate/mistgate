{{template "head" .}}<body>
{{template "header" .}}
<main>
<section class="__ph__">
<span class="__eb__">{{.L.nav_changelog}}</span>
<h1>{{.L.changelog_h}}</h1>
<p class="__sub__">{{.L.changelog_intro}}</p>
</section>
<section class="__sec__ __ln__">
{{range .Lists.releases}}<div class="__rl__"><div class="__v__"><h2><a href="{{.href}}">{{.version}}</a></h2><span><time datetime="{{.date_iso}}">{{.date}}</time></span></div><div class="__dt__"><i></i></div><div>{{template "notes" .}}<a class="__src__" href="{{.href}}">{{$.L.rel_src_h}} {{icon "arrow"}}</a></div></div>
{{end}}</section>
</main>
{{template "footer" .}}
</body>
</html>
