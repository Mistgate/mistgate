{{template "head" .}}<body>
{{template "header" .}}
<main>
<section class="__hero__"><div class="__wrap__ __hgrid1__">
<div class="__ht__"><span class="__kick__">{{.L.nav_privacy}}</span><h1>{{.L.privacy_h}}</h1><p class="__lead__">{{.L.privacy_intro}}</p></div>
</div></section>
<div class="__wrap__ __sec__ __pv__">
<nav class="__toc2__" aria-label="{{.L.toc_h}}"><h6>{{.L.toc_h}}</h6>{{range $i, $s := .L.privacy}}<a href="#s{{add $i 1}}">{{$s.h}}</a>{{end}}</nav>
<div>{{range $i, $s := .L.privacy}}<article class="__it__" id="s{{add $i 1}}"><div class="__ic2__">{{template "ico" $i}}</div><div><h2>{{$s.h}}</h2><p>{{$s.p}}</p></div></article>
{{end}}<p class="__back__"><a class="__btn__" href="/">{{.L.help_back}}</a></p></div>
</div>
</main>
{{template "footer" .}}
</body>
</html>
