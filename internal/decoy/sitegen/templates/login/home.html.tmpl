{{define "loginform"}}<form class="__form__" id="__f__" onsubmit="return false" novalidate>
<h2>{{.L.nav_home}}</h2>
<div class="__fld__"><label for="__u__">{{.L.f_user}}</label><input id="__u__" type="text" autocomplete="username" autocapitalize="off" spellcheck="false"></div>
<div class="__fld__"><label for="__p__">{{.L.f_pass}}</label><input id="__p__" type="password" autocomplete="current-password"></div>
<div class="__row__"><label class="__chk__"><input type="checkbox"><span>{{.L.f_remember}}</span></label><a href="{{(index .Nav 1).Href}}">{{.L.f_forgot}}</a></div>
<p class="__err__" id="__e__" role="alert" hidden></p>
<button class="__btn__ __wide__" id="__b__" type="button">{{.L.f_submit}}</button>
<p class="__sub__"><a href="{{(index .Nav 1).Href}}">{{.L.nav_help}}</a><a href="{{(index .Nav 2).Href}}">{{.L.nav_privacy}}</a></p>
</form>
{{end}}
{{define "ltext"}}<span class="__kick__">{{.L.kicker}}</span>
<h1>{{.L.welcome}}</h1>
<p class="__lead__">{{.L.lead}}</p>
<ul class="__bul__">{{range .L.bullets}}<li>{{icon "checkc"}}<span>{{.}}</span></li>{{end}}</ul>{{end}}
{{define "b_help"}}<section class="__sec__"><div class="__wrap__ __help__">
<div><h2 class="__big__">{{.L.help_h}}</h2><p class="__intro__">{{.L.help_intro}}</p>
<div class="__still__ __still2__"><h3>{{.L.help_contact_h}}</h3><p>{{.L.help_contact}}</p></div></div>
<ol class="__steps__">{{range .L.help_steps}}<li>{{.}}</li>
{{end}}</ol>
</div></section>{{end}}
{{define "b_priv"}}<section class="__sec__ __priv__"><div class="__wrap__">
<h2 class="__big__">{{.L.privacy_h}}</h2>
<p class="__intro__">{{.L.privacy_intro}}</p>
<div class="__pg__">{{range $i, $x := .L.privacy}}<div><span class="__pi__">{{template "ico" $i}}</span><h3>{{$x.h}}</h3><p>{{$x.p}}</p></div>
{{end}}</div>
</div></section>{{end}}
{{template "head" .}}<body>
{{if eq .Layout 2}}{{template "header" .}}
<main>
<section class="__hero__"><div class="__ghost__">{{template "ill" .}}</div>
<div class="__wrap__ __hgrid__">
<div class="__ht__">{{template "ltext" .}}</div>
<div class="__fc__ __bx__">{{template "loginform" .}}</div>
</div>
</section>
{{else}}<main>
<section class="__split__">
<div class="__pl__">
{{if eq .Layout 1}}{{if hasphoto "side" 640 900}}<div class="__ph__">{{photo "side" "" 640 900}}</div>
{{end}}{{end}}<div class="__ghost__">{{template "ill" .}}</div>
<a class="__logo__" href="/">{{.Mark}}<span>{{.Brand}}</span></a>
<div class="__ht__">{{template "ltext" .}}</div>
<div class="__meta__"><span>{{.L.tagline}}</span></div>
</div>
<div class="__fr__"><div class="__fc__">{{template "loginform" .}}</div></div>
</section>
{{end}}{{range .Order}}{{blk . $}}{{end}}
</main>
{{template "footer" .}}
<script src="{{.JS}}" defer></script>
</body>
</html>
