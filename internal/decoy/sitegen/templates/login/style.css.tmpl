{{template "base_vars" .}}{{template "base_core" .}}{{template "base_pages" .}}{{template "draw_css" .}}
h1,h2,h3{color:var(--fg)}
h1{margin:24px 0 20px;font-size:var(--t5);line-height:.98;overflow-wrap:anywhere;hyphens:auto}
a{color:inherit}
.__top__{position:relative;border-bottom:1px solid var(--ln);background:var(--band)}
.__topin__{display:flex;align-items:center;justify-content:space-between;gap:24px;height:76px}
.__logo__{display:flex;align-items:center;gap:10px;min-width:0;color:var(--fg);font:650 1.2rem/1 var(--fh);letter-spacing:-.01em;text-decoration:none;position:relative}
.__logo__ span{min-width:0;overflow:hidden;text-overflow:ellipsis}
.__logo__ .__mark__{width:30px;height:30px}
.__nav__{display:flex;gap:6px;font-size:.94rem}
.__nav__ a{padding:8px 16px;border-radius:99px;color:var(--mu);text-decoration:none}
.__nav__ a:hover{color:var(--fg)}
.__nav__ a[aria-current]{background:var(--sf2);color:var(--fg)}
.__mnb__{margin-right:0;border:1px solid var(--ln2);border-radius:var(--rs);background:var(--sf)}
.__mnl__{background:var(--band);border-bottom:1px solid var(--ln);box-shadow:none}
.__mnl__ a{border-bottom-color:var(--ln)}
.__mnl__ a[aria-current]{color:var(--ac)}
.__btn__{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 26px;border:0;border-radius:var(--rs);background:var(--ac);color:var(--ai);font:650 1rem var(--fb);text-decoration:none;cursor:pointer}
.__btn__:hover{filter:brightness(1.08)}
.__btn__:focus-visible{outline:2px solid var(--fg);outline-offset:3px}
.__wide__{width:100%;min-height:54px;font-size:1.05rem}
.__wide__:disabled{opacity:.7;cursor:progress}
.__inv__{background:var(--bg);color:var(--fg)}
.__kick__{display:inline-flex;align-items:center;padding:6px 14px;border:1px solid var(--ln2);border-radius:99px;color:color-mix(in srgb,var(--ac) 70%,var(--fg));font:600 .8rem var(--fl);letter-spacing:.08em;text-transform:uppercase}
.__lead__{max-width:28em;margin:0 0 30px;color:var(--mu);font-size:clamp(17px,1.4vw,21px)}
.__bul__{display:grid;gap:14px;margin:0;padding:0;list-style:none}
.__bul__ li{display:flex;gap:12px;align-items:center;font-size:1.05rem}
.__bul__ .__ic__{width:24px;height:24px;color:var(--a2)}
.__ill__{display:block;width:100%;height:auto}
.__gl__{fill:none;stroke:var(--ln2);stroke-width:1.2px}
.__gr__,.__gr2__{fill:none;stroke:var(--ac);stroke-width:2px}
.__gr2__{stroke:var(--ln2);stroke-width:1.2px}
.__ga__{fill:none;stroke:var(--a2);stroke-width:2px;stroke-linecap:round}
.__lk__{fill:var(--ac)}
.__sh__{fill:none;stroke:var(--ac);stroke-width:12px;stroke-linecap:round}
.__kh__{fill:var(--band)}
.__qm__{fill:none;stroke:var(--band);stroke-width:10px;stroke-linecap:round}
.__d1__{fill:var(--a2)}
.__d2__{fill:var(--ln2)}
.__ghost__{position:absolute;pointer-events:none}
.__split__{display:grid;min-height:min(100vh,860px)}
.__pl__{position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;gap:48px;padding:clamp(28px,3.4vw,52px) clamp(24px,5vw,80px);background:var(--band)}
.__pl__ .__ghost__{right:-8%;bottom:-9%;width:64%}
.__ht__{position:relative;max-width:620px}
.__meta__{position:relative;color:var(--mu);font-size:.88rem}
.__fr__{display:flex;flex-direction:column;justify-content:center;padding:clamp(24px,4vw,64px)}
.__fc__{width:100%;max-width:420px;margin:0 auto}
.__form__ h2{margin:0 0 26px;font-size:clamp(1.6rem,2.4vw,2.1rem);letter-spacing:-.03em}
.__fld__{gap:8px;margin-bottom:20px}
.__fld__ label{color:var(--mu);font-size:.9rem;font-weight:500}
.__fld__ input{min-height:52px;padding:0 16px;border:1px solid var(--ln2);border-radius:var(--rs);background:var(--sf);color:var(--fg)}
.__fld__ input:focus{outline:2px solid var(--ac);outline-offset:1px;border-color:var(--ac)}
.__row__{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 12px;margin:2px 0 24px;font-size:.92rem}
.__row__ a{color:color-mix(in srgb,var(--ac) 70%,var(--fg))}
.__chk__{display:flex;align-items:center;gap:10px;cursor:pointer}
.__chk__ input{appearance:none;flex:none;width:20px;height:20px;margin:0;border:1.5px solid var(--ln2);border-radius:6px;background:var(--sf);cursor:pointer}
.__chk__ input:checked{border-color:var(--ac);background:var(--ac);box-shadow:inset 0 0 0 4px var(--sf)}
.__chk__ input:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
.__err__{margin:0 0 14px;padding:.65em .85em;border:1px solid var(--bd);border-radius:var(--rs);background:var(--bds);color:var(--fg);font-size:.92rem}
.__err__[hidden]{display:none}
.__sub__{display:flex;justify-content:center;gap:18px;margin:26px 0 0;color:var(--mu);font-size:.9rem}
.__sub__ a{text-decoration:none}
.__sub__ a:hover{color:var(--fg)}
.__sec__{padding-top:clamp(56px,7vw,104px);padding-bottom:clamp(56px,7vw,104px)}
.__help__{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(32px,6vw,96px);align-items:start}
.__help__ > *{min-width:0}
.__big__{margin:0 0 16px;font-size:var(--t4);line-height:1.05;letter-spacing:-.035em}
.__intro__{max-width:26em;margin:0 0 32px;color:var(--mu);font-size:1.1rem}
.__still__{padding:28px;border:1px solid var(--ln2);border-radius:var(--rb);background:var(--sf)}
.__still__ h3{margin:0 0 8px;font-size:1.2rem}
.__still__ p{margin:0;color:var(--mu)}
.__steps__{margin:0;padding:0;list-style:none;counter-reset:s}
.__steps__ li{counter-increment:s;display:grid;grid-template-columns:64px 1fr;gap:20px;align-items:center;padding:24px 0;border-top:1px solid var(--ln);font-size:1.15rem}
.__steps__ li:last-child{border-bottom:1px solid var(--ln)}
.__steps__ li::before{content:counter(s,decimal-leading-zero);color:var(--mu);font:var(--fwh) 2.1rem/1 var(--fh);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.__priv__{padding-bottom:clamp(56px,7vw,104px);border-top:1px solid var(--ln);background:var(--band)}
.__priv__ .__intro__{margin-bottom:0}
.__pg__{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:40px}
.__pg__ > div{padding:24px;border:1px solid var(--ln);border-radius:var(--r);background:var(--bg)}
.__pi__{display:block;margin-bottom:18px;color:var(--ac)}
.__pi__ .__ic__,.__ic2__ .__ic__{width:28px;height:28px}
.__pg__ h3{margin:0 0 8px;font-size:1.1rem;font-weight:600;letter-spacing:0}
.__pg__ p{margin:0;color:var(--mu);font-size:.95rem}
.__hero__{position:relative;overflow:hidden;border-bottom:1px solid var(--ln);background:var(--band)}
.__hgrid__{position:relative;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:48px;align-items:center;padding-top:clamp(40px,5vw,80px);padding-bottom:clamp(40px,5vw,80px)}
.__hgrid1__{padding-top:clamp(40px,5vw,80px);padding-bottom:clamp(40px,5vw,80px)}
.__hgrid2__{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:48px;align-items:center;padding-top:clamp(40px,5vw,80px);padding-bottom:clamp(40px,5vw,80px)}
.__hgrid2__ .__ill__{max-width:420px;justify-self:end}
.__hgrid1__ h1,.__hgrid2__ h1{font-size:var(--t4)}
.__hgrid1__ .__lead__,.__hgrid2__ .__lead__{margin:0}
.__g2__{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:0;padding:0;list-style:none}
.__st__{display:flex;flex-direction:column;gap:clamp(28px,4vw,56px);min-height:210px;padding:32px;border:1px solid var(--ln2);border-radius:var(--rb);background:var(--sf)}
.__st__ b{color:var(--mu);font:var(--fwh) 3.4rem/.8 var(--fh);letter-spacing:-.05em;font-variant-numeric:tabular-nums}
.__st__ p{margin:0;font-size:1.25rem;line-height:1.4;letter-spacing:-.01em}
.__still__:not(.__still2__){display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;margin-top:20px;padding:clamp(28px,3.4vw,48px);border:0;border-radius:calc(var(--rb)*1.2);background:var(--ac);color:var(--ai)}
.__still__:not(.__still2__) h2{margin:0 0 8px;color:inherit;font-size:var(--t3);letter-spacing:-.035em}
.__still__:not(.__still2__) p{max-width:38em;color:inherit;font-size:1.1rem}
.__pv__{display:grid;grid-template-columns:260px minmax(0,1fr);gap:clamp(32px,6vw,96px);align-items:start}
.__toc2__{position:sticky;top:24px;font-size:.94rem}
.__toc2__ h6{margin:0 0 12px;color:var(--mu);font:600 .75rem var(--fl);letter-spacing:.1em;text-transform:uppercase}
.__toc2__ a{display:block;padding:8px 14px;border-left:2px solid var(--ln);color:var(--mu);text-decoration:none}
.__toc2__ a:hover{border-color:var(--ac);color:var(--fg)}
.__it__{display:grid;grid-template-columns:72px minmax(0,1fr);gap:24px;padding:36px 0;border-top:1px solid var(--ln);scroll-margin-top:16px}
.__it__:nth-of-type(1){border-top:0;padding-top:0}
.__ic2__{display:grid;place-items:center;width:64px;height:64px;border:1px solid var(--ln2);border-radius:var(--r);background:var(--sf);color:var(--ac)}
.__ic2__ .__ic__{width:30px;height:30px}
.__it__ h2{margin:0 0 8px;font-size:var(--t3);line-height:1.1;letter-spacing:-.035em}
.__it__ p{max-width:34em;margin:0;color:var(--mu);font-size:1.1rem}
.__back__{margin:36px 0 0}
.__foot__{margin-top:0;padding:56px 0 32px;border-top:1px solid var(--ln);background:color-mix(in srgb,var(--bg) 60%,#000)}
.__fg__{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.__fg__ h6{margin:0 0 14px;color:var(--mu);font:600 .8rem var(--fl);letter-spacing:.08em;text-transform:uppercase}
.__fg__ a{display:block;padding:4px 0;color:var(--mu);font-size:.94rem;text-decoration:none}
.__fg__ a:hover{color:var(--fg)}
.__fg__ .__logo__{display:flex;padding:0;color:var(--fg)}
.__fg__ p{max-width:20em;margin:14px 0 0;color:var(--mu);font-size:.94rem}
.__fbar__{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px 16px;margin-top:40px;color:var(--mu);font-size:.88rem}
.__lg__{padding-bottom:clamp(40px,5vw,72px)}
.__toc__{border-color:var(--ln);background:var(--sf)}
.__code__{color:var(--ac)}
.__nfa__{border:1px solid var(--ln2)}
{{if eq .Layout 0}}.__split__{grid-template-columns:minmax(0,1.25fr) minmax(0,1fr)}
{{else if eq .Layout 1}}.__split__{grid-template-columns:minmax(0,1fr) minmax(0,1.25fr)}
.__pl__{order:2;justify-content:flex-start;gap:36px}
.__fr__{order:1;background:var(--bg)}
.__pl__ .__ghost__{position:relative;right:auto;bottom:auto;order:3;width:min(100%,460px);margin:auto 0 -6% auto}
.__pl__ .__logo__{order:0}
.__pl__ .__ht__{order:1}
.__pl__ .__meta__{display:none}
.__ph__{position:absolute;inset:0;opacity:.28}
.__ph__ img,.__ph__ svg{width:100%;height:100%;object-fit:cover}
{{else}}.__hero__{border-bottom:0}
.__hero__ .__ghost__{top:50%;right:-6%;width:min(70vw,780px);opacity:.7;transform:translateY(-50%)}
.__hgrid__{gap:clamp(32px,6vw,96px);grid-template-columns:minmax(0,1fr) minmax(0,420px)}
.__fc__.__bx__{padding:clamp(24px,3vw,40px);border:1px solid var(--ln2);border-radius:var(--rb);background:var(--sf);box-shadow:0 24px 60px rgba(0,0,0,.35)}
.__hgrid__ h1{font-size:var(--t4)}
{{end}}@media (max-width:900px){.__nav__{display:none}.__mn__{display:block}.__split__,.__hgrid__,.__hgrid2__,.__help__,.__pv__,.__still__:not(.__still2__){grid-template-columns:1fr}.__split__{min-height:0}.__pl__{gap:36px}.__pl__ .__ghost__{position:relative;right:auto;bottom:auto;order:5;width:min(86%,460px);margin:0 auto -48px}.__fr__{padding:40px 20px 56px}.__pl__{order:0}.__fr__{order:1}.__meta__{display:none}.__pg__{grid-template-columns:1fr 1fr}.__fg__{grid-template-columns:1fr 1fr}.__fb__{grid-column:1/-1}.__toc2__{display:none}.__hgrid2__ .__ill__{justify-self:center;max-width:300px;grid-row:1}.__still__:not(.__still2__) .__btn__{justify-self:start}}
@media (max-width:560px){.__pg__,.__g2__{grid-template-columns:1fr}.__steps__ li{grid-template-columns:48px 1fr;font-size:1.05rem}.__it__{grid-template-columns:52px minmax(0,1fr);gap:16px}.__ic2__{width:52px;height:52px}.__st__{min-height:0;padding:24px}h1{font-size:clamp(2rem,10vw,var(--t5))}.__hgrid1__ h1,.__hgrid2__ h1,.__hgrid__ h1{font-size:clamp(2rem,9.6vw,var(--t4))}}
