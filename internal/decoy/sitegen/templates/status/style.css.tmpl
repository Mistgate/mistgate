{{template "base_vars" .}}{{template "base_core" .}}{{template "base_pages" .}}{{template "draw_css" .}}
.__mono__{font-family:var(--fm);font-variant-numeric:tabular-nums}
.__top__{position:relative;background:var(--sf);border-bottom:var(--bw) solid var(--ln)}
.__topin__{display:flex;align-items:center;justify-content:space-between;height:68px;gap:24px}
.__logo__{display:flex;align-items:center;gap:10px;color:var(--fg);text-decoration:none;font:650 1.12rem var(--fh);letter-spacing:var(--lsh);min-width:0}
.__logo__ small{font:500 .8rem var(--fb);color:var(--mu);border-left:1px solid var(--ln2);padding-left:10px;margin-left:2px}
.__nav__{display:flex;gap:6px}
.__nav__ a{padding:8px 14px;border-radius:var(--rs);color:var(--mu);text-decoration:none;font-size:.94rem}
.__nav__ a:hover{color:var(--fg)}
.__nav__ a[aria-current]{background:var(--sf2);color:var(--fg);font-weight:600}
.__st__{padding-top:32px;padding-bottom:8px}
.__st__ h1{font-size:var(--t4);line-height:1.05;margin:14px 0 10px}
.__sec__{margin-top:var(--sec)}
.__sech__{display:flex;justify-content:space-between;align-items:baseline;gap:8px 16px;flex-wrap:wrap;margin-bottom:16px}
.__sech__ h2,.__ch__ h2{margin:0}
.__sech__ small{color:var(--mu);font-size:.8rem}
.__lede__{margin:0;font-size:1.1rem;color:var(--mu);max-width:36em}
.__crumb__{margin:0;font-size:.88rem;color:var(--mu)}
.__crumb__ a{color:var(--ac);font-weight:600;text-decoration:none}
.__card__{background:var(--sf);border:var(--bw) solid var(--ln);border-radius:var(--r);padding:28px;box-shadow:var(--sh)}
.__btn__,.__more__{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:1px solid var(--ln2);border-radius:var(--rs);background:var(--sf);color:var(--fg);font-weight:600;text-decoration:none}
.__btn__:hover,.__more__:hover{border-color:var(--ac)}
.__pill__{display:inline-block;border-radius:99px;padding:3px 10px;font-size:.78rem;font-weight:650;vertical-align:2px;white-space:nowrap;background:var(--oks);color:var(--ok);color:color-mix(in srgb,var(--ok) 62%,var(--fg))}
.__imp1__{background:var(--was);color:var(--wa);color:color-mix(in srgb,var(--wa) 60%,var(--fg))}
.__imp2__{background:var(--bds);color:var(--bd);color:color-mix(in srgb,var(--bd) 62%,var(--fg))}
.__imp3__{background:var(--so);background:color-mix(in srgb,var(--a2) 14%,var(--sf));color:var(--a2);color:color-mix(in srgb,var(--a2) 70%,var(--fg))}
.__chip__{display:inline-flex;align-items:center;gap:8px;background:var(--sf);border-radius:99px;padding:6px 14px 6px 10px;font-size:.88rem;font-weight:600;color:var(--fg)}
.__dot__{width:10px;height:10px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px var(--oks)}
.__bad__ .__dot__{background:var(--bd);box-shadow:0 0 0 4px var(--bds)}
.__hero__{position:relative;overflow:hidden;display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:center;margin-top:var(--s);padding:clamp(28px,4vw,56px);border-radius:var(--rb);background:var(--oks)}
.__hero__::before{content:"";position:absolute;right:-20px;top:-20px;width:420px;height:300px;opacity:.4;background:radial-gradient(var(--ok) 1.6px,transparent 1.8px) 0 0/20px 20px}
.__hero__>*{position:relative}
.__hero__ h1{font-size:var(--t5);letter-spacing:-.035em;margin:18px 0 14px}
.__big__{text-align:right}
.__big__ b{display:block;font-size:var(--t5);line-height:1;letter-spacing:-.04em;font-weight:600}
.__big__ span{font-size:.94rem}
.__grid2__{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-top:20px}
.__ch__{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:20px}
.__ch__ b{font-size:var(--t3);letter-spacing:-.03em;font-weight:600;white-space:nowrap}
.__cht__ .__dchart__{height:220px}
.__cht__ .__dline__{stroke:var(--ok)}
.__cht__ .__darea__,.__cht__ .__dpt__{fill:var(--ok)}
.__axis__{display:flex;justify-content:space-between;margin-top:8px;color:var(--mu);font-size:.8rem}
.__side__{display:grid;gap:20px}
.__stat__{display:flex;flex-direction:column;justify-content:space-between;gap:12px}
.__stat__ b{font-size:var(--t5);line-height:1;letter-spacing:-.04em;font-weight:600}
.__stat__ span{color:var(--mu)}
.__hm__{margin-top:auto}
.__stat__ i{font-style:normal;font-size:.8rem;font-weight:600;align-self:flex-start;padding:3px 10px;border-radius:99px;background:var(--oks);color:var(--ok);color:color-mix(in srgb,var(--ok) 62%,var(--fg))}
.__tbl__{background:var(--sf);border:var(--bw) solid var(--ln);border-radius:var(--r);overflow:hidden}
.__row__,.__scale__{display:grid;grid-template-columns:minmax(0,220px) 1fr 90px 150px;gap:24px;align-items:center;padding:18px 28px;border-top:1px solid var(--ln)}
.__scale__{padding:12px 28px 0;border-top:0;font-size:.8rem;color:var(--mu)}
.__scale__ div{display:flex;justify-content:space-between}
.__row__ .__n__{font-weight:600;min-width:0;overflow-wrap:anywhere}
.__bars__{display:flex;gap:2px;height:32px}
.__bars__ i{flex:1;min-width:0;background:var(--ok);border-radius:3px}
.__bars__ .__w__{background:var(--wa)}
.__bars__ .__x__{background:var(--bd)}
.__bars__ .__o4__{opacity:.93}
.__bars__ .__o5__{opacity:.86}
.__pc__{text-align:right;color:var(--mu);font-size:.94rem}
.__ok__{display:inline-flex;align-items:center;gap:6px;justify-self:end;padding:4px 12px 4px 8px;border-radius:99px;background:var(--oks);color:var(--ok);color:color-mix(in srgb,var(--ok) 62%,var(--fg));font-size:.88rem;font-weight:600;white-space:nowrap}
.__ok__ .__ic__{width:16px;height:16px}
.__tlc__{padding:36px 32px 8px}
.__tl__{list-style:none;margin:0;padding:0}
.__tlc__ .__tl__ li{position:relative;display:grid;grid-template-columns:150px minmax(0,1fr);gap:24px;padding:0 0 32px}
.__tlc__ .__tl__ li::before{content:"";position:absolute;left:162px;top:10px;bottom:-10px;width:2px;background:var(--ln)}
.__tlc__ .__tl__ li:last-child::before{display:none}
.__tlc__ .__tl__ li::after{content:"";position:absolute;left:157px;top:8px;width:12px;height:12px;border-radius:50%;background:var(--sf);border:3px solid var(--ln2)}
.__tl__ .__d__{color:var(--mu);font-size:.88rem;padding-top:2px}
.__tl__ .__b__{padding-left:40px;min-width:0}
.__ti__{font-size:1.1rem;font-weight:650;letter-spacing:-.01em;color:var(--fg);text-decoration:none;margin-right:10px}
.__tl__ p{margin:6px 0 0;color:var(--mu);max-width:44em}
.__tl__ .__m__{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:10px;font-size:.8rem;color:var(--mu)}
.__abt__{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.__abt__ .__no__,.__abr__ .__no__{display:block;font-size:.8rem;color:var(--mu);margin-bottom:10px}
.__abt__ h3{margin:0 0 8px;font-size:1.05rem}
.__abt__ p{margin:0;font-size:.94rem;color:var(--mu)}
.__cal__{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:32px;padding:32px}
.__mo__ h3{margin:0 0 14px}
.__wd__,.__dy__{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}
.__wd__{margin-bottom:6px;font-size:.68rem;color:var(--mu);text-align:center}
.__dy__ i{display:block;aspect-ratio:1;border-radius:6px;background:var(--ok)}
.__dy__ .__e__{background:transparent}
.__dy__ .__f__{background:var(--ln)}
.__dy__ .__n__,.__leg__ .__n__{background:var(--wa)}
.__dy__ .__m__,.__leg__ .__m__{background:var(--bd)}
.__dy__ .__t__,.__leg__ .__t__{background:var(--a2)}
.__leg__{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px 22px;font-size:.88rem;color:var(--mu)}
.__leg__ span{display:flex;align-items:center;gap:8px}
.__leg__ i{width:14px;height:14px;border-radius:4px;background:var(--ok)}
.__grp__{margin-top:40px}
.__grp__ h2{margin:0;padding-bottom:12px;border-bottom:2px solid var(--fg)}
.__li__{display:grid;grid-template-columns:130px minmax(0,1fr) auto 190px;gap:20px;align-items:center;padding:20px 0;border-bottom:1px solid var(--ln);color:var(--fg);text-decoration:none}
.__li__ b{font-size:1.1rem;letter-spacing:-.01em;font-weight:600}
.__li__:hover b{color:var(--ac)}
.__li__ .__d__{color:var(--mu);font-size:.88rem}
.__li__ .__u__{text-align:right;color:var(--mu);font-size:.88rem}
.__head__{margin-top:4px;display:flex;flex-wrap:wrap;gap:10px 24px;align-items:center;color:var(--mu);margin-bottom:8px}
.__ig__{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:24px;margin-top:32px;align-items:start}
.__itl__{padding:36px 36px 8px}
.__itl__ .__tl__ li{position:relative;padding:0 0 32px 36px}
.__itl__ .__tl__ li::before{content:"";position:absolute;left:7px;top:22px;bottom:-4px;width:2px;background:var(--ln)}
.__itl__ .__tl__ li:last-child::before{display:none}
.__itl__ .__tl__ li::after{content:"";position:absolute;left:0;top:5px;width:16px;height:16px;border-radius:50%;background:var(--sf);border:4px solid var(--ln2)}
.__itl__ .__tl__ li:first-child::after{border-color:var(--ok)}
.__itl__ .__tl__ li:nth-child(2)::after{border-color:var(--wa)}
.__itl__ strong{font-size:1.1rem}
.__itl__ .__t__{margin-left:10px;color:var(--mu);font-size:.8rem}
.__itl__ .__tl__ p{font-size:1.04rem;color:var(--fg)}
.__sd__{padding:24px;margin-bottom:20px}
.__sd__ h2{margin:0;font-size:1.3rem}
.__aff__,.__mlist__{list-style:none;margin:16px 0 0;padding:0}
.__aff__ li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--ln)}
.__mlist__ li{display:flex;flex-direction:column;gap:2px;padding:12px 0;border-top:1px solid var(--ln);font-weight:600}
.__mlist__ a{color:var(--fg);text-decoration:none}
.__mlist__ a:hover{color:var(--ac)}
.__mlist__ span{font-weight:400;color:var(--mu);font-size:.8rem}
.__ab__{margin-top:32px}
.__abr__{display:grid;grid-template-columns:90px minmax(0,1fr);gap:24px;padding:28px 0;border-top:1px solid var(--ln);scroll-margin-top:16px}
.__abr__ h2{margin:0 0 8px;font-size:1.3rem}
.__abr__ p{margin:0;max-width:var(--wt);color:var(--mu)}
.__abl__{margin-top:24px}
.__abl__ h2{margin:0 0 8px;font-size:1.3rem}
.__abl__ ul{list-style:none;margin:0;padding:0}
.__abl__ li{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-top:1px solid var(--ln)}
.__nfm__{padding-top:56px}
.__nfc__{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding:clamp(24px,4vw,48px)}
.__nfc__ h1{margin:14px 0 4px}
.__nfc__ .__bars__{width:100%;margin:24px 0}
.__nfc__ p{margin:0}
.__nfc__ .__chip__ b{font-size:1.1rem}
.__ft__{margin-top:72px;padding:56px 0 28px;background:var(--fg);color:var(--bg)}
.__ft__ a{color:var(--bg);color:color-mix(in srgb,var(--bg) 66%,var(--fg));text-decoration:none}
.__ft__ a:hover{color:var(--bg)}
.__fg__{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:40px}
.__fg__ h4{margin:0 0 14px;font:600 .88rem var(--fb);letter-spacing:0;color:var(--bg)}
.__fg__ a{display:block;padding:4px 0;font-size:.94rem;overflow-wrap:anywhere}
.__fl__{display:flex;align-items:center;gap:10px;font:650 1.12rem var(--fh);color:var(--bg)}
.__fg__ p{margin:12px 0 0;font-size:.94rem;color:var(--bg);color:color-mix(in srgb,var(--bg) 66%,var(--fg));max-width:22em}
.__fb__{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 16px;margin-top:40px;padding-top:20px;border-top:1px solid;border-color:color-mix(in srgb,var(--bg) 20%,var(--fg));font-size:.88rem;color:color-mix(in srgb,var(--bg) 55%,var(--fg))}
{{if eq .Scheme "both"}}@media (prefers-color-scheme:dark){.__ft__{background:var(--sf);color:var(--fg);border-top:1px solid var(--ln)}.__ft__ a,.__fg__ p{color:var(--mu)}.__ft__ a:hover,.__fg__ h4,.__fl__{color:var(--fg)}.__fb__{border-color:var(--ln);color:var(--mu)}}
{{end}}{{if eq .Layout 1}}.__hero__{background:var(--sf);border:var(--bw) solid var(--ln);border-left:8px solid var(--ok);box-shadow:var(--sh)}
.__hero__::before{display:none}
.__chip__{background:var(--oks)}
.__big__{border-left:1px solid var(--ln);padding-left:32px}
{{else if eq .Layout 2}}.__hero__{display:block;text-align:center;background:none;padding:clamp(20px,3vw,40px) 0 8px}
.__hero__::before{display:none}
.__hero__ .__lede__{margin:0 auto}
.__hero__ h1{color:var(--ok);color:color-mix(in srgb,var(--ok) 70%,var(--fg))}
.__big__{display:inline-flex;align-items:baseline;gap:14px;margin-top:28px;padding:10px 24px;border-radius:99px;background:var(--sf);border:var(--bw) solid var(--ln);text-align:center}
.__big__ b{font-size:var(--t3)}
.__chip__{background:var(--oks)}
{{end}}@media (max-width:900px){
.__hero__{grid-template-columns:1fr;gap:24px}
.__big__{text-align:left}
.__grid2__,.__side__,.__cal__,.__ig__{grid-template-columns:1fr}
.__row__{grid-template-columns:minmax(0,1fr) auto;gap:12px 16px;padding:18px 20px}
.__row__ .__bars__{grid-column:1/-1;order:3}
.__row__ .__pc__{order:2;grid-column:1;text-align:left;font-size:.8rem}
.__row__ .__ok__{grid-row:1;grid-column:2}
.__scale__{display:none}
.__tlc__ .__tl__ li{grid-template-columns:1fr;gap:4px}
.__tlc__ .__tl__ li::before,.__tlc__ .__tl__ li::after{left:5px}
.__tlc__ .__tl__ li::before{left:9px}
.__tlc__ .__tl__ li::after{left:4px}
.__tl__ .__d__,.__tl__ .__b__{padding-left:40px}
.__abt__,.__fg__{grid-template-columns:1fr 1fr}
.__fg__>div:first-child{grid-column:1/-1}
.__li__{grid-template-columns:minmax(0,1fr) auto;gap:6px 12px}
.__li__ .__u__{grid-column:1/-1;text-align:left}
.__li__ .__d__{grid-column:1/-1}
.__logo__ small{display:none}
.__card__{padding:22px}
.__hero__::before{width:260px;height:200px;opacity:.22}
{{if eq .Layout 1}}.__big__{border-left:0;padding-left:0}{{end}}{{if eq .Layout 2}}.__big__{text-align:center}{{end}}
}
@media (max-width:720px){.__nav__{display:none}}
@media (max-width:560px){.__abt__,.__fg__{grid-template-columns:1fr}.__ch__{flex-direction:column;align-items:flex-start}.__tlc__{padding:28px 20px 8px}.__itl__{padding:28px 22px 8px}.__abr__{grid-template-columns:1fr;gap:6px}.__st__{padding-top:20px}}
