{{template "base_css" .}}
.__sec__{margin-top:44px}
.__kicker__{margin:0 0 8px;color:var(--ac);font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.__lede__{max-width:620px;color:var(--mu);font-size:1.12rem}
.__hero__ h1{margin-bottom:.3em;font-size:clamp(2rem,5.2vw,3rem)}
.__page__{padding-top:48px}
.__narrow__{max-width:760px}
.__page__ h2{margin-top:1.4em}
.__meet__ h2{margin-bottom:.5em;font-size:1.15rem}
.__meet__ p{display:flex;gap:10px;align-items:flex-start}
.__meet__ strong{display:block;color:var(--mu);font-size:.8rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
.__meet__ .__ic__{margin-top:.25em;color:var(--ac)}
.__feats__{display:grid;gap:20px 28px;margin:0;padding:0;list-style:none;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))}
.__feats__ li{display:flex;gap:14px;align-items:flex-start}
.__feats__ h3{margin:0 0 2px}
.__feats__ p{margin:0;color:var(--mu);font-size:.95rem}
.__fi__{display:grid;place-items:center;width:44px;height:44px;flex:none;border-radius:var(--rs);background:var(--so);color:var(--ac)}
.__ev__{margin:14px 0;padding:0;list-style:none}
.__ev__ li{display:grid;gap:4px 20px;grid-template-columns:150px minmax(0,1fr);padding:14px 0;border-bottom:1px solid var(--ln)}
.__ev__ p{margin:.15em 0 0;color:var(--mu);font-size:.95rem}
.__ev__ h2{margin:0;font-size:1.15rem}
.__when__{color:var(--ac);font-size:.9rem;font-weight:700}
.__full__ li{padding:20px 0}
.__post__{padding:16px 0;border-bottom:1px solid var(--ln)}
.__post__ h2,.__post__ h3{margin:0 0 .25em}
.__post__ p{margin:.1em 0}
{{if nphotos}}.__cov__{margin:28px 0 32px;overflow:hidden;border-radius:var(--r)}
.__cov__ .__art__{aspect-ratio:3/1;height:auto}
@media (max-width:560px){.__cov__ .__art__{aspect-ratio:2/1}}
{{end}}{{if eq .Layout 0}}.__split__{display:grid;gap:40px;align-items:center;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);padding-top:56px}
.__cols__{display:grid;gap:12px 56px;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
{{else if eq .Layout 1}}.__band__{background:var(--so)}
.__centre__{padding-top:64px;padding-bottom:56px;text-align:center}
.__centre__ .__lede__{margin-right:auto;margin-left:auto}
{{else}}.__duo__{display:grid;gap:48px;align-items:start;grid-template-columns:minmax(0,1fr) 300px;padding-top:48px}
.__sticky__{position:sticky;top:20px}
{{end}}@media (max-width:820px){.__split__,.__cols__,.__duo__{display:block}.__split__{padding-top:32px}.__split__ .__meet__{margin-top:24px}.__duo__{padding-top:32px}.__sticky__{position:static;margin-top:28px}.__centre__{padding-top:44px;padding-bottom:36px}}
@media (max-width:560px){.__ev__ li{display:block}.__when__{display:block;margin-bottom:2px}.__page__{padding-top:32px}}
