{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__">
<section class="__hd2__">
<div class="__sky__">{{art "hd" "" 400 300}}</div>
<div class="__hd2t__"><span class="__kick__">{{.L.kicker}}</span><h1>{{.L.join_h}}</h1><p class="__lead__">{{index .L.join 0}}</p></div>
</section>
<section class="__sec__">
<div class="__jn__">
<div>
<div class="__fee2__"><b>{{.L.join_h}}</b><p>{{.L.join_fee}}</p></div>
<div class="__jb__"><h3>{{.L.steps_h}}</h3>{{range $i, $p := .L.join}}{{if gt $i 0}}<p>{{$p}}</p>
{{end}}{{end}}<ol class="__st__">{{range .L.steps}}<li>{{.}}</li>{{end}}</ol></div>
</div>
<div>
<div class="__jb__ __gap__"><h3>{{.L.faq_h}}</h3>{{range .L.faq}}<details class="__qd__" open><summary>{{.q}}</summary><p>{{.a}}</p></details>{{end}}</div>
<div class="__jb__ __gap__"><h3>{{.L.find_h}}</h3>
<p class="__iline__">{{icon "clock"}} <span>{{.L.when}}</span></p>
<p class="__iline__">{{icon "pin"}} <span>{{.L.where}}, {{.V.address}}</span></p>
{{if .V.phone}}<p class="__iline__">{{icon "phone"}} <span>{{.V.phone}}</span></p>
{{end}}</div>
{{if not .V.phone}}{{template "contactform" .}}
<script src="{{.JS}}" defer></script>
{{end}}</div>
</div>
</section>
</main>
{{template "footer" .}}
</body>
</html>
