{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __page__ __narrow__">
<h1>{{.L.join_h}}</h1>
{{range .L.join}}<p>{{.}}</p>
{{end}}<p>{{.L.join_fee}}</p>
<h2>{{.L.steps_h}}</h2>
<ol>{{range .L.steps}}<li>{{.}}</li>{{end}}</ol>
<h2>{{.L.faq_h}}</h2>
{{range .L.faq}}<h3>{{.q}}</h3>
<p>{{.a}}</p>
{{end}}<h2>{{.L.find_h}}</h2>
<p>{{icon "clock"}} {{.L.when}}</p>
<p>{{icon "pin"}} {{.L.where}}, {{.V.address}}</p>
{{if .V.phone}}<p>{{icon "phone"}} {{.L.phone_l}}: {{.V.phone}}</p>
{{else}}{{template "contactform" .}}
<script src="{{.JS}}" defer></script>
{{end}}</main>
{{template "footer" .}}
</body>
</html>
