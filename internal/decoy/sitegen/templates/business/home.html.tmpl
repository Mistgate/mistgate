{{define "b_feat"}}<section class="__sec__">
<ul class="__feats__">{{range .L.features}}<li><span class="__fi__">{{icon .icon}}</span><div><h3>{{.h}}</h3><p>{{.p}}</p></div></li>{{end}}</ul>
</section>{{end}}
{{define "b_prices"}}<section class="__sec__">
<h2>{{.L.services_h}}</h2>
<ul class="__price__">{{range $i, $s := .L.services}}{{if lt $i 3}}<li><div><strong>{{$s.t}}</strong><span>{{$s.d}}</span></div><em>{{if $s.from}}{{$.L.from_l}} {{end}}{{money $s.price}}</em></li>{{end}}{{end}}</ul>
<p><a href="{{(index .Nav 1).Href}}">{{.L.all_prices}} {{icon "arrow"}}</a></p>
</section>{{end}}
{{define "b_visit"}}<section class="__sec__ __visit__">
<div class="__card__">
<h2>{{.L.visit_h}}</h2>
<p>{{icon "pin"}} {{.V.address}}</p>
{{if .V.phone}}<p>{{icon "phone"}} {{.V.phone}}</p>
{{end}}</div>
<div class="__card__">
<h2>{{.L.hours_h}}</h2>
<ul class="__hours__">{{range .L.hours}}<li>{{hrs .from .to .open .close}}</li>{{end}}{{if .L.hours_note}}<li>{{.L.hours_note}}</li>{{end}}</ul>
</div>
</section>{{end}}
{{template "head" .}}<body>
{{template "header" .}}
<main>
{{if eq .Layout 0}}<section class="__wrap__ __hero__ __split__">
<div>
<h1>{{.L.hero_h}}</h1>
<p class="__lede__">{{.L.intro}}</p>
<p><a class="__btn__" href="{{(index .Nav 1).Href}}">{{.L.see_services}}</a></p>
</div>
<figure class="__figure__">{{photo "hero" "" 640 480}}</figure>
</section>
{{else if eq .Layout 1}}<section class="__band__">
<div class="__wrap__ __hero__ __centre__">
<h1>{{.L.hero_h}}</h1>
<p class="__lede__">{{.L.intro}}</p>
<p><a class="__btn__" href="{{(index .Nav 1).Href}}">{{.L.see_services}}</a></p>
</div>
</section>
{{else}}<section class="__cover__">
{{photo "hero" "" 1200 560}}
<div class="__wrap__ __coverin__">
<h1>{{.L.hero_h}}</h1>
<p class="__lede__">{{.L.intro}}</p>
<p><a class="__btn__" href="{{(index .Nav 1).Href}}">{{.L.see_services}}</a></p>
</div>
</section>
{{end}}<div class="__wrap__">
{{range .Order}}{{blk . $}}{{end}}
{{if hasphoto "g1" 640 480}}{{if hasphoto "g2" 640 480}}<div class="__pics__"><figure class="__figure__">{{photo "g1" "" 640 480}}</figure><figure class="__figure__">{{photo "g2" "" 640 480}}</figure></div>
{{end}}{{end}}</div>
</main>
{{template "footer" .}}
</body>
</html>
