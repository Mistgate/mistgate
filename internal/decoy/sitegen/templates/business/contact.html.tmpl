{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__ __page__">
<h1>{{.L.contact_h}}</h1>
<p class="__lede__">{{.L.contact_intro}}</p>
<section class="__visit__">
<div class="__card__">
<h2>{{.L.address_l}}</h2>
<p>{{icon "pin"}} {{.V.address}}</p>
{{if .V.phone}}<h2>{{.L.phone_l}}</h2>
<p>{{icon "phone"}} {{.V.phone}}</p>
{{end}}</div>
<div class="__card__">
<h2>{{.L.hours_h}}</h2>
<ul class="__hours__">{{range .L.hours}}<li>{{hrs .from .to .open .close}}</li>{{end}}{{if .L.hours_note}}<li>{{.L.hours_note}}</li>{{end}}</ul>
</div>
</section>
<h2>{{.L.directions_h}}</h2>
<p>{{.L.directions}}</p>
<p class="__mu__">{{.L.contact_note}}</p>
{{if not .V.phone}}{{template "contactform" .}}
<script src="{{.JS}}" defer></script>
{{end}}</main>
{{template "footer" .}}
</body>
</html>
