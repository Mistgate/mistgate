{{template "head" .}}<body>
{{template "header" .}}
<main class="__wrap__">
<section class="__hd2__ __hd2s__">
<div><h1>{{.L.contact_h}}</h1><p class="__lead__">{{.L.contact_intro}}</p></div>
</section>
<div class="__cg__">
<div class="__map__">{{mapsvg "contact" 640 440}}<div class="__pin__"><b>{{.L.address_l}}</b>{{.V.address}}</div></div>
<div class="__card__ __dkc__"><h3>{{.L.hours_h}}</h3>
<ul class="__hr__">{{range .L.hours}}<li>{{hrs .from .to .open .close}}</li>{{end}}{{if .L.hours_note}}<li>{{.L.hours_note}}</li>{{end}}</ul></div>
</div>
<section class="__dir__">
<div><h2>{{.L.directions_h}}</h2><p>{{.L.directions}}</p><p>{{.L.contact_note}}</p></div>
{{if .V.phone}}<div class="__card__ __soft__ __tel__"><h3>{{.L.phone_l}}</h3><p>{{icon "phone"}} {{.V.phone}}</p></div>
{{else}}{{template "contactform" .}}
<script src="{{.JS}}" defer></script>
{{end}}</section>
</main>
{{template "footer" .}}
</body>
</html>
