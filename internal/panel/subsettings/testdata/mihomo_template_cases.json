{
 "note": "Read by TestMihomoTemplateCases: what a save of one Mihomo template takes. lines are joined with newlines; auto_off is link_auto_select off; gen names a text the test builds (too big to write out); err is a part of the message.",
 "cases": [
  {
   "name": "an author's router template with anchors, a merge key and a provider",
   "ok": true,
   "lines": [
    "mixed-port: 7890",
    "redir-port: 7892",
    "allow-lan: true",
    "mode: rule",
    "log-level: warning",
    "",
    "x-check: &check",
    "  url: https://www.gstatic.com/generate_204",
    "  interval: 300",
    "",
    "proxy-providers:",
    "  office:",
    "    type: http",
    "    url: https://example.com/office.yaml",
    "    interval: 3600",
    "",
    "proxy-groups:",
    "  - name: Proxy",
    "    type: select",
    "    include-all-proxies: true",
    "    proxies: [Auto, DIRECT]",
    "  - name: Fast",
    "    <<: *check",
    "    type: url-test",
    "    include-all-proxies: true",
    "  - name: Office",
    "    type: select",
    "    use: [office]",
    "",
    "rule-providers:",
    "  ads:",
    "    type: http",
    "    behavior: domain",
    "    format: mrs",
    "    url: https://example.com/ads.mrs",
    "    interval: 86400",
    "",
    "rules:",
    "  - RULE-SET,ads,REJECT",
    "  - DOMAIN-SUFFIX,example.com,Office",
    "  - GEOIP,LAN,DIRECT,no-resolve",
    "  - MATCH,Proxy"
   ]
  },
  {
   "name": "the smallest useful template",
