# uri-list
## de1 | hy2 443 | hysteria2 | direct
hysteria2://<secret>@de1.example.com:443/?obfs=salamander&obfs-password=golden-obfs-password&sni=de1.example.com#de1%20%C2%B7%20hy2%20%C2%B7%20443
## nl1 | hy2 443 | hysteria2 | direct
hysteria2://<secret>@nl1.example.com:443/?obfs=salamander&obfs-password=golden-obfs-password&sni=nl1.example.com#nl1%20%C2%B7%20hy2%20%C2%B7%20443
## nl1 | hy2 8443 | hysteria2 | direct
hysteria2://<secret>@nl1.example.com:8443/?sni=nl1.example.com#nl1%20%C2%B7%20hy2%20%C2%B7%208443
# mihomo-yaml
## de1 | hy2 443 | hysteria2 | direct
- name: "de1 · hy2 · 443"
  type: hysteria2
  server: "de1.example.com"
  port: 443
  password: "<secret>"
  obfs: salamander
  obfs-password: "golden-obfs-password"
  sni: "de1.example.com"
  skip-cert-verify: false
  alpn: [h3]

## nl1 | hy2 443 | hysteria2 | direct
- name: "nl1 · hy2 · 443"
  type: hysteria2
  server: "nl1.example.com"
  port: 443
  password: "<secret>"
  obfs: salamander
  obfs-password: "golden-obfs-password"
  sni: "nl1.example.com"
  skip-cert-verify: false
  alpn: [h3]

## nl1 | hy2 8443 | hysteria2 | direct
- name: "nl1 · hy2 · 8443"
  type: hysteria2
  server: "nl1.example.com"
  port: 8443
  password: "<secret>"
  sni: "nl1.example.com"
  skip-cert-verify: false
  alpn: [h3]

